@model AsliHalwaiWebApp.ViewModel.CustomerMenuVM

@{
    ViewData["Title"] = "Menu";
}

<style>
    .box {
        border: 1px solid #eee;
        padding: 10px;
        background: #fff;
        margin-bottom: 16px;
        height: 100%;
    }

        .box .image {
            width: 100%;
            aspect-ratio: 1 / 1; /* square image */
            overflow: hidden;
            background: #f3f3f3;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .box .image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .box h4 {
            font-size: 14px;
            margin: 8px 0 4px;
            line-height: 1.3;
        }

        .box .des {
            font-size: 12px;
            color: #666;
            margin-bottom: 6px;
        }

        .box .price {
            font-size: 15px;
            font-weight: 700;
            color: #ff4d00;
        }

    /* MOBILE FIX */
    media (max-width: 576px) {
        .menu .row > div

    {
        padding-left: 6px;
        padding-right: 6px;
    }

    }
</style>



<!-- ================= Breadcrumb ================= -->
<div class="bread-crumb">
    <div class="container">
        <div class="matter">
            <h2>Menu</h2>
            <ul class="list-inline">
                <li class="list-inline-item">
                    <a asp-controller="Home" asp-action="Index">HOME</a>
                </li>
                <li class="list-inline-item">
                    <a asp-controller="Home" asp-action="Menu">OUR MENU</a>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- ================= MENU ================= -->
<div class="menu">
    <div class="menu-inner">
        <div class="container">

            <!-- TITLE -->
            <div class="row">
                <div class="col-sm-12 commontop text-center">
                    <h4>Our Menu</h4>
                </div>
            </div>

            <!-- ================= TABS ================= -->
            <ul class="nav nav-tabs list-inline">
                @{
                    bool firstTab = true;
                    foreach (var category in Model.Categories)
                    {
                        var tabId = category.StockCategory.Replace(" ", "_").ToLower();
                        <li class="nav-item">
                            <a class="nav-link @(firstTab ? "active" : "")"
                               data-toggle="tab"
                               href="#@tabId">
                                @category.StockCategory
                            </a>
                        </li>
                        firstTab = false;
                    }
                }
            </ul>

            <!-- ================= TAB CONTENT ================= -->
            <div class="tab-content">
                @{
                    bool firstContent = true;
                    foreach (var category in Model.Categories)
                    {
                        var tabId = category.StockCategory.Replace(" ", "_").ToLower();
                        <div class="tab-pane @(firstContent ? "show active" : "")" id="@tabId">

                            <div class="row">
                                @foreach (var item in category.Items)
                                {
                                    <!-- 🔥 Mobile = 2 items | Desktop = 2 -->
                                    <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                                        <div class="box">
                                            <div class="image">
                                                <img src="@Url.Content(item.ItemPhotoPath)"
                                                     alt="@item.StockItemTitle" />
                                            </div>

                                            <h4>@item.StockItemTitle</h4>
                                            <p class="des">@item.ItemSize | @item.OrderType</p>
                                            <div class="price">₹ @item.UnitPrice</div>
                                        </div>
                                    </div>
                                }
                            </div>

                        </div>
                        firstContent = false;
                    }
                }
            </div>

        </div>
    </div>
</div>
