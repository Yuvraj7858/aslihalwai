@model AsliHalwaiWebApp.ViewModel.CustomerMenuVM

@{
    ViewData["Title"] = "Full Dining & Takeaway Menu - AsliHalwai";
}

<div class="container py-3">
    <!-- Breadcrumb & Title -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent p-0 mb-1" style="font-size: 13px;">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active text-muted" aria-current="page">Menu</li>
                </ol>
            </nav>
            <h2 class="font-weight-bold mb-0" style="color: #111827; font-size: clamp(22px, 3vw, 28px);">
                Our Complete Food Menu
            </h2>
            <p class="text-muted mb-0 small">
                Authentic sweets, savoury snacks, chaat, and cold refreshments made fresh daily.
            </p>
        </div>

        <div class="mt-3 mt-md-0">
            <a asp-controller="Home" asp-action="AllItems" class="btn ah-btn-pill-primary">
                Order for Delivery <i class="icofont icofont-arrow-right"></i>
            </a>
        </div>
    </div>

    @if (Model.Categories != null && Model.Categories.Any())
    {
        <!-- Category Tabs Navigation -->
        <ul class="nav nav-pills ah-category-tabs justify-content-start mb-4" role="tablist">
            @{
                bool firstTab = true;
                foreach (var category in Model.Categories)
                {
                    var tabId = "menu_cat_" + category.StockCategory.Replace(" ", "_").ToLower();
                    <li class="nav-item mr-2 mb-2">
                        <a class="nav-link @(firstTab ? "active" : "")"
                           data-toggle="pill"
                           href="#@tabId"
                           style="border-radius: var(--ah-radius-pill); font-weight: 700; font-size: 13.5px; padding: 8px 20px;">
                            <i class="icofont icofont-restaurant mr-1"></i> @category.StockCategory
                        </a>
                    </li>
                    firstTab = false;
                }
            }
        </ul>

        <!-- Category Tab Content -->
        <div class="tab-content">
            @{
                bool firstContent = true;
                foreach (var category in Model.Categories)
                {
                    var tabId = "menu_cat_" + category.StockCategory.Replace(" ", "_").ToLower();
                    <div class="tab-pane fade @(firstContent ? "show active" : "")" id="@tabId">
                        <div class="row">
                            @{
                                int idx = 0;
                                string[] tags = { "Bestseller", "Most Loved", "Premium", "Trending" };
                                string[] tagClasses = { "ah-tag-bestseller", "ah-tag-loved", "ah-tag-premium", "ah-tag-trending" };
                                string[] times = { "15-20 min", "20-30 min", "15-25 min", "25-35 min" };
                            }
                            @foreach (var item in category.Items)
                            {
                                var tag = tags[idx % tags.Length];
                                var tagClass = tagClasses[idx % tagClasses.Length];
                                var time = times[idx % times.Length];
                                idx++;

                                <!-- 2-column mobile (col-6), 3-column tablet (col-sm-6), 4-column desktop (col-lg-3) -->
                                <div class="col-6 col-sm-6 col-lg-3 mb-3 mb-sm-4 px-2">
                                    <div class="ah-dish-card">
                                        <div class="ah-dish-img-wrap">
                                            <span class="@tagClass">@tag</span>
                                            <span class="ah-fav-heart"><i class="icofont icofont-heart-alt"></i></span>
                                            <img src="@Url.Content(item.ItemPhotoPath)"
                                                 class="ah-dish-img"
                                                 alt="@item.StockItemTitle"
                                                 onerror="this.src='/Template/assets/images/about/3.jpg'" />
                                        </div>

                                        <h5 class="ah-dish-title" title="@item.StockItemTitle">
                                            @item.StockItemTitle
                                        </h5>

                                        <p class="ah-dish-desc">
                                            @(!string.IsNullOrEmpty(item.ItemSize) ? $"Portion: {item.ItemSize} • " : "")@item.OrderType
                                        </p>

                                        <div class="ah-dish-price-row">
                                            <span class="ah-dish-price">₹ @item.UnitPrice</span>
                                            <span class="ah-dish-time">@time</span>
                                        </div>

                                        <div class="ah-dish-footer">
                                            <span class="ah-dish-rating">
                                                <i class="fa fa-star"></i> 4.8
                                            </span>
                                            <a asp-controller="Home"
                                               asp-action="AllItems"
                                               class="ah-btn-add-pill"
                                               style="font-size: 11.5px; padding: 5px 14px;">
                                                Order <i class="icofont icofont-arrow-right"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    firstContent = false;
                }
            }
        </div>
    }
</div>
