@model AsliHalwaiWebApp.ViewModel.ForgotPasswordVM

@{
    ViewData["Title"] = "Create New Password - AsliHalwai";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7 col-12">
            <div class="ah-auth-card">
                <div class="ah-auth-header">
                    <img src="~/Template/assets/images/logo/logo.png" alt="AsliHalwai" />
                    <h3 class="ah-auth-title">Set New Password</h3>
                    <p class="ah-auth-desc">Please choose a secure new password for your account</p>
                </div>

                <form asp-action="ResetPassword" asp-controller="AccountRecovery" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" style="border-radius: var(--ah-radius-md);"></div>

                    @Html.HiddenFor(x => x.UserID)
                    @Html.HiddenFor(x => x.UserName)
                    @Html.HiddenFor(x => x.EmailAddress)

                    <!-- New Password -->
                    <div class="ah-input-group">
                        <i class="icofont icofont-lock"></i>
                        <input asp-for="NewPassword"
                               type="password"
                               class="form-control"
                               placeholder="Enter new password"
                               required />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="ah-input-group">
                        <i class="icofont icofont-shield-check"></i>
                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control"
                               placeholder="Confirm new password"
                               required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn ah-btn-primary mb-3">
                        <i class="icofont icofont-check-circled"></i> Save New Password
                    </button>

                    <!-- Back to Login -->
                    <div class="text-center mt-3 pt-3 border-top" style="font-size: 14px;">
                        <a asp-controller="User" asp-action="Login" class="font-weight-bold" style="color: var(--ah-primary);">
                            <i class="icofont icofont-arrow-left"></i> Back to Sign In
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
