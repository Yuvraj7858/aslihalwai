@model AsliHalwaiWebApp.ViewModel.AccountRecoveryVM

@{
    ViewData["Title"] = "Account Recovery - AsliHalwai";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7 col-12">
            <div class="ah-auth-card">
                <div class="ah-auth-header">
                    <img src="~/Template/assets/images/logo/logo.png" alt="AsliHalwai" />
                    <h3 class="ah-auth-title">Reset Password</h3>
                    <p class="ah-auth-desc">Enter your registered email or username to receive a password reset link</p>
                </div>

                <form asp-action="AccountRecovery" asp-controller="AccountRecovery" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" style="border-radius: var(--ah-radius-md);"></div>

                    <!-- Username / Email -->
                    <div class="ah-input-group">
                        <i class="icofont icofont-ui-message"></i>
                        <input asp-for="UserName"
                               class="form-control"
                               placeholder="Enter username or email address"
                               required />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn ah-btn-primary mb-3">
                        <i class="icofont icofont-paper-plane"></i> Send Recovery Link
                    </button>

                    <!-- Back to Login -->
                    <div class="text-center mt-3 pt-3 border-top" style="font-size: 14px;">
                        <a asp-controller="User" asp-action="Login" class="font-weight-bold" style="color: var(--ah-primary);">
                            <i class="icofont icofont-arrow-left"></i> Back to Sign In
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
