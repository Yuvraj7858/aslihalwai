@model AsliHalwaiWebApp.ViewModels.GenderVM

@{
    ViewData["Title"] = "Genders - AsliHalwai Admin";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent p-0 mb-1" style="font-size: 13px;">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="AdminOrder" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item active text-muted" aria-current="page">Genders</li>
                </ol>
            </nav>
            <h3 class="font-weight-bold mb-1" style="color: #0f172a;">Genders</h3>
            <p class="text-muted mb-0 small">
                Manage gender options for customer account profiles.
            </p>
        </div>
    </div>

    <div class="row">
        <!-- FORM -->
        <div class="col-md-5 mb-4">
            <div class="ah-dish-card p-3 p-md-4">
                <h5 class="font-weight-bold mb-3" style="color: #111827;">
                    @(Model.GenderID == 0 ? "Add New Gender" : "Edit Gender")
                </h5>

                <form asp-action="List_Genders" asp-controller="Setting" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                    <input type="hidden" asp-for="GenderID" />

                    <div class="form-group mb-3">
                        <label class="font-weight-bold small text-muted">Gender Title *</label>
                        <input asp-for="GenderTitle"
                               class="form-control"
                               placeholder="e.g. Male, Female, Other"
                               required
                               style="height: 44px; border-radius: var(--ah-radius-md);" />
                        <span asp-validation-for="GenderTitle" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        @if (Model.GenderID > 0)
                        {
                            <a asp-action="List_Genders" class="btn btn-outline-secondary" style="border-radius: var(--ah-radius-pill);">
                                Cancel
                            </a>
                        }
                        <button type="submit" class="btn ah-btn-pill-primary">
                            @(Model.GenderID == 0 ? "Save Gender" : "Update")
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- LIST -->
        <div class="col-md-7">
            <div class="ah-dish-card p-3 p-md-4">
                <h5 class="font-weight-bold mb-3" style="color: #111827;">Existing Genders</h5>

                <div class="table-responsive">
                    <table class="table ah-cart-table">
                        <thead>
                            <tr>
                                <th>Gender Title</th>
                                <th style="width:160px" class="text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Genders != null && Model.Genders.Any())
                            {
                                foreach (var item in Model.Genders)
                                {
                                    <tr>
                                        <td><strong class="text-dark">@item.GenderTitle</strong></td>
                                        <td class="text-right">
                                            <a asp-controller="Setting"
                                               asp-action="List_Genders"
                                               asp-route-id="@item.GenderID"
                                               class="btn btn-sm btn-outline-primary mr-1"
                                               style="border-radius: var(--ah-radius-pill);">
                                                Edit
                                            </a>

                                            <form asp-action="DeleteGender"
                                                  asp-controller="Setting"
                                                  asp-route-id="@item.GenderID"
                                                  method="post"
                                                  style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        style="border-radius: var(--ah-radius-pill);"
                                                        onclick="return confirm('Delete this gender?');">
                                                    Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-center py-4 text-muted">
                                        No records found
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
