@model AsliHalwaiWebApp.ViewModel.ShoppingCartVM
@using AsliHalwaiWebApp.ViewModel

@{
    ViewData["Title"] = "Shopping Cart & Checkout";
    var cartItems = Model?.CartItems ?? new List<CartVM>();
    decimal totalamount = cartItems.Sum(x => x.ItemCost);
}

<div class="container py-4">
    <!-- Stepper Navigation Header -->
    <div class="mb-4">
        <ul class="nav nav-tabs ah-checkout-stepper border-0" role="tablist">
            <li class="nav-item">
                <a class="nav-link ah-step-item active" data-toggle="tab" href="#tab-cart">
                    <span class="ah-step-circle">1</span>
                    <span>Order Cart</span>
                </a>
            </li>
            <li class="ah-step-line d-none d-sm-block"></li>
            <li class="nav-item">
                <a class="nav-link ah-step-item" data-toggle="tab" href="#tab-info">
                    <span class="ah-step-circle">2</span>
                    <span>Delivery Details</span>
                </a>
            </li>
            <li class="ah-step-line d-none d-sm-block"></li>
            <li class="nav-item">
                <a class="nav-link ah-step-item" data-toggle="tab" href="#tab-payment">
                    <span class="ah-step-circle">3</span>
                    <span>Payment Mode</span>
                </a>
            </li>
        </ul>
    </div>

    @if (!cartItems.Any())
    {
        <div class="ah-cart-card text-center py-5">
            <i class="icofont icofont-shopping-cart text-muted" style="font-size: 64px;"></i>
            <h4 class="font-weight-bold mt-3" style="color: #1e293b;">Your cart is empty</h4>
            <p class="text-muted">Looks like you haven't added any sweets or snacks yet.</p>
            <a asp-controller="Home" asp-action="AllItems" class="btn ah-btn-primary mt-2" style="display: inline-flex; width: auto;">
                Explore Our Shop
            </a>
        </div>
    }
    else
    {
        <form asp-action="ViewCart" asp-controller="Order" method="post" id="cartCheckoutForm">
            @Html.AntiForgeryToken()

            <div class="tab-content">
                <!-- ================= STEP 1: CART ITEMS ================= -->
                <div class="tab-pane fade show active" id="tab-cart">
                    <div class="row">
                        <!-- Items Table Column -->
                        <div class="col-lg-8 mb-4">
                            <div class="ah-cart-card">
                                <h5 class="font-weight-bold mb-3" style="color: #1e293b;">
                                    <i class="icofont icofont-cart text-primary"></i> Order Items (@cartItems.Count)
                                </h5>

                                <!-- Desktop Table -->
                                <div class="table-responsive d-none d-md-block">
                                    <table class="table ah-cart-table">
                                        <thead>
                                            <tr>
                                                <th>Item Details</th>
                                                <th class="text-center">Price</th>
                                                <th class="text-center">Quantity</th>
                                                <th class="text-center">Subtotal</th>
                                                <th class="text-center">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in cartItems)
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <img src="@Url.Content(item.ItemPhotoPath)"
                                                                 alt="@item.StockItemTitle"
                                                                 class="rounded mr-3"
                                                                 style="width: 60px; height: 60px; object-fit: cover; border: 1px solid #edf2f7;"
                                                                 onerror="this.src='/Template/assets/images/about/3.jpg'" />
                                                            <div>
                                                                <strong style="color: #0f172a; font-size: 14.5px;">@item.StockItemTitle</strong>
                                                                @if (!string.IsNullOrEmpty(item.ItemSize))
                                                                {
                                                                    <br /><small class="text-muted">Portion: @item.ItemSize</small>
                                                                }
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="text-center font-weight-bold" style="color: #475569;">
                                                        ₹ @item.UnitPrice
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="ah-qty-stepper">
                                                            <button type="button" class="ah-qty-btn"
                                                                    onclick="updateQty(@item.CartItemId, '@item.ItemType', -1)">
                                                                &minus;
                                                            </button>
                                                            <span class="ah-qty-val">@item.Qty</span>
                                                            <button type="button" class="ah-qty-btn"
                                                                    onclick="updateQty(@item.CartItemId, '@item.ItemType', 1)">
                                                                &#43;
                                                            </button>
                                                        </div>
                                                    </td>
                                                    <td class="text-center font-weight-bold" style="color: var(--ah-primary); font-size: 15px;">
                                                        ₹ @item.ItemCost
                                                    </td>
                                                    <td class="text-center">
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-danger"
                                                                style="border-radius: var(--ah-radius-pill); width: 32px; height: 32px; padding: 0;"
                                                                onclick="removeItem(@item.CartItemId, '@item.ItemType')"
                                                                title="Remove item">
                                                            &times;
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Mobile List View -->
                                <div class="d-md-none">
                                    @foreach (var item in cartItems)
                                    {
                                        <div class="p-3 border rounded mb-3" style="background: #ffffff;">
                                            <div class="d-flex align-items-center mb-2">
                                                <img src="@Url.Content(item.ItemPhotoPath)"
                                                     alt="@item.StockItemTitle"
                                                     class="rounded mr-3"
                                                     style="width: 60px; height: 60px; object-fit: cover;"
                                                     onerror="this.src='/Template/assets/images/about/3.jpg'" />
                                                <div class="flex-fill">
                                                    <h6 class="font-weight-bold mb-1" style="font-size: 14px;">@item.StockItemTitle</h6>
                                                    <small class="text-muted">₹ @item.UnitPrice @(!string.IsNullOrEmpty(item.ItemSize) ? $"({item.ItemSize})" : "")</small>
                                                </div>
                                                <button type="button"
                                                        class="btn btn-sm text-danger"
                                                        onclick="removeItem(@item.CartItemId, '@item.ItemType')">
                                                    <i class="icofont icofont-trash" style="font-size: 18px;"></i>
                                                </button>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                                <div class="ah-qty-stepper">
                                                    <button type="button" class="ah-qty-btn" onclick="updateQty(@item.CartItemId, '@item.ItemType', -1)">&minus;</button>
                                                    <span class="ah-qty-val">@item.Qty</span>
                                                    <button type="button" class="ah-qty-btn" onclick="updateQty(@item.CartItemId, '@item.ItemType', 1)">&#43;</button>
                                                </div>
                                                <span class="font-weight-bold" style="color: var(--ah-primary); font-size: 16px;">
                                                    ₹ @item.ItemCost
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Order Summary Card -->
                        <div class="col-lg-4">
                            <div class="ah-cart-card" style="position: sticky; top: 85px;">
                                <h5 class="font-weight-bold mb-3" style="color: #1e293b;">Bill Summary</h5>

                                <div class="d-flex justify-content-between mb-2" style="font-size: 14px; color: #64748b;">
                                    <span>Item Total</span>
                                    <span class="font-weight-bold text-dark">₹ @totalamount</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2" style="font-size: 14px; color: #64748b;">
                                    <span>Delivery Partner Fee</span>
                                    <span class="text-success font-weight-bold">FREE</span>
                                </div>
                                <div class="d-flex justify-content-between mb-3" style="font-size: 14px; color: #64748b;">
                                    <span>Taxes &amp; Charges</span>
                                    <span class="font-weight-bold text-dark">₹ 0.00</span>
                                </div>

                                <hr />

                                <div class="d-flex justify-content-between mb-4">
                                    <span class="font-weight-bold" style="font-size: 17px; color: #0f172a;">To Pay</span>
                                    <span class="font-weight-bold" style="font-size: 22px; color: var(--ah-primary);">₹ @totalamount</span>
                                </div>

                                <a class="btn ah-btn-primary" data-toggle="tab" href="#tab-info">
                                    Proceed to Delivery <i class="icofont icofont-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ================= STEP 2: DELIVERY INFO ================= -->
                <div class="tab-pane fade" id="tab-info">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="ah-cart-card">
                                <h5 class="font-weight-bold mb-4" style="color: #1e293b;">
                                    <i class="icofont icofont-location-pin text-primary"></i> Delivery &amp; Contact Information
                                </h5>

                                <div class="row">
                                    <!-- Order Type -->
                                    <div class="col-md-6 mb-3">
                                        <label class="font-weight-bold small text-muted">Order Type *</label>
                                        <select asp-for="OrderTypeId" class="form-control" required style="height: 48px; border-radius: var(--ah-radius-md);">
                                            <option value="">-- Select Order Type --</option>
                                            @if (Model.OrderTypes != null)
                                            {
                                                foreach (var ot in Model.OrderTypes)
                                                {
                                                    <option value="@ot.Value">@ot.Text</option>
                                                }
                                            }
                                        </select>
                                    </div>

                                    <!-- Delivery Address -->
                                    <div class="col-md-6 mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label class="font-weight-bold small text-muted mb-0">Delivery Address *</label>
                                            <a asp-controller="Setting" asp-action="List_UserAddress" class="small text-primary font-weight-bold">
                                                + Add New
                                            </a>
                                        </div>
                                        <select asp-for="UserAddressId" class="form-control" required style="height: 48px; border-radius: var(--ah-radius-md);">
                                            <option value="">-- Select Saved Address --</option>
                                            @if (Model.Addresses != null)
                                            {
                                                foreach (var ad in Model.Addresses)
                                                {
                                                    <option value="@ad.Value">@ad.Text</option>
                                                }
                                            }
                                        </select>
                                    </div>

                                    <!-- First Name -->
                                    <div class="col-md-6 mb-3">
                                        <label class="font-weight-bold small text-muted">First Name *</label>
                                        <input asp-for="FirstName" class="form-control" placeholder="Enter first name" required style="height: 48px; border-radius: var(--ah-radius-md);" />
                                    </div>

                                    <!-- Last Name -->
                                    <div class="col-md-6 mb-3">
                                        <label class="font-weight-bold small text-muted">Last Name</label>
                                        <input asp-for="LastName" class="form-control" placeholder="Enter last name" style="height: 48px; border-radius: var(--ah-radius-md);" />
                                    </div>

                                    <!-- Mobile Phone -->
                                    <div class="col-md-12 mb-4">
                                        <label class="font-weight-bold small text-muted">Contact Mobile Number *</label>
                                        <input asp-for="ContactNo" class="form-control" placeholder="Enter 10-digit mobile number" required style="height: 48px; border-radius: var(--ah-radius-md);" />
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                    <a class="btn ah-btn-secondary" data-toggle="tab" href="#tab-cart">
                                        <i class="icofont icofont-arrow-left"></i> Back to Cart
                                    </a>
                                    <a class="btn ah-btn-primary" data-toggle="tab" href="#tab-payment" style="display: inline-flex; width: auto;">
                                        Continue to Payment <i class="icofont icofont-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ================= STEP 3: PAYMENT ================= -->
                <div class="tab-pane fade" id="tab-payment">
                    <div class="row justify-content-center">
                        <div class="col-lg-7">
                            <div class="ah-cart-card">
                                <h5 class="font-weight-bold mb-4" style="color: #1e293b;">
                                    <i class="icofont icofont-credit-card text-primary"></i> Select Payment Method
                                </h5>

                                <!-- Cash on Delivery -->
                                <label class="ah-payment-option selected" id="codOptionLabel">
                                    <input class="form-check-input mt-0 position-static"
                                           type="radio"
                                           name="PaymentMode"
                                           value="COD"
                                           checked />
                                    <div>
                                        <strong style="color: #0f172a; font-size: 15px;">Cash on Delivery (COD)</strong>
                                        <p class="text-muted mb-0 small">Pay in cash or scanner upon order delivery at your doorstep.</p>
                                    </div>
                                </label>

                                <!-- Pay via UPI -->
                                <label class="ah-payment-option" id="upiOptionLabel">
                                    <input class="form-check-input mt-0 position-static"
                                           type="radio"
                                           name="PaymentMode"
                                           value="UPI"
                                           id="upiRadio" />
                                    <div>
                                        <strong style="color: #0f172a; font-size: 15px;">Instant UPI Transfer</strong>
                                        <p class="text-muted mb-0 small">Google Pay, PhonePe, Paytm, BHIM or any banking app.</p>
                                    </div>
                                </label>

                                <!-- UPI Details Box -->
                                <div id="upiBox" class="p-4 border rounded mt-3 text-center" style="display:none; background: #fff8f5; border-color: #ffd8c7 !important;">
                                    <p class="mb-1 font-weight-bold text-dark">Scan &amp; Pay via UPI QR Code</p>
                                    <p class="mb-3 text-muted small"><strong>UPI ID:</strong> <span class="badge badge-light border text-primary">aslihalwai@upi</span></p>

                                    <img src="~/images/upi-qr.jpeg"
                                         style="width: 180px; height: 180px; object-fit: contain; background: #fff; border-radius: 12px;"
                                         alt="UPI QR Code"
                                         class="shadow-sm border p-2 mb-3"
                                         onerror="this.src='/Template/assets/images/about/1.png'" />

                                    <div class="text-left mt-2 max-w-400 mx-auto">
                                        <label class="font-weight-bold small text-muted">Enter UPI Transaction Reference (UTR) *</label>
                                        <input type="text"
                                               name="PaymentUTR"
                                               class="form-control"
                                               placeholder="12-digit UTR from your UPI app"
                                               style="height: 46px; border-radius: var(--ah-radius-md);" />
                                        <small class="text-muted">Enter the 12-digit UTR reference number from your payment confirmation.</small>
                                    </div>
                                </div>

                                <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="text-muted small d-block">Total Payable</span>
                                        <strong style="font-size: 24px; color: var(--ah-primary);">₹ @totalamount</strong>
                                    </div>

                                    <button type="submit" class="btn ah-btn-primary" style="display: inline-flex; width: auto; padding: 12px 32px;">
                                        <i class="icofont icofont-check-circled"></i> PLACE ORDER
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        function updateQty(cartItemId, itemType, change) {
            $.post('/Order/UpdateQty', { cartItemId, itemType, change }, function (res) {
                if (res === true) location.reload();
            });
        }

        function removeItem(cartItemId, itemType) {
            if (!confirm("Remove this item from your cart?")) return;
            $.post('/Order/RemoveItem', { cartItemId, itemType }, function (res) {
                if (res === true) location.reload();
            });
        }

        // Handle payment method toggling & styling
        document.querySelectorAll('input[name="PaymentMode"]').forEach(radio => {
            radio.addEventListener('change', function () {
                const upiBox = document.getElementById('upiBox');
                const codLabel = document.getElementById('codOptionLabel');
                const upiLabel = document.getElementById('upiOptionLabel');

                if (this.value === 'UPI') {
                    if (upiBox) upiBox.style.display = 'block';
                    if (upiLabel) upiLabel.classList.add('selected');
                    if (codLabel) codLabel.classList.remove('selected');
                } else {
                    if (upiBox) upiBox.style.display = 'none';
                    if (codLabel) codLabel.classList.add('selected');
                    if (upiLabel) upiLabel.classList.remove('selected');
                }
            });
        });

        // Form submission check
        $('#cartCheckoutForm').on('submit', function () {
            const paymentMode = $('input[name="PaymentMode"]:checked').val();
            if (paymentMode === 'UPI') {
                const utr = $('input[name="PaymentUTR"]').val();
                if (!utr || utr.trim().length < 6) {
                    alert('Please enter a valid UPI Transaction ID (UTR) to complete your order.');
                    return false;
                }
            }
            return true;
        });
    </script>
}
