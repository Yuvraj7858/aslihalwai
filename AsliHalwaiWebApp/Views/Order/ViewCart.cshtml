@model AsliHalwaiWebApp.ViewModel.ShoppingCartVM
@using AsliHalwaiWebApp.ViewModel

@{
    var cartItems = Model?.CartItems ?? new List<CartVM>();
    decimal totalamount = cartItems.Sum(x => x.ItemCost);
}


<div class="bread-crumb">
    <div class="container">
        <h2>Shopping Cart</h2>
    </div>
</div>

<div class="mycart">
    <div class="container">

        <!-- TABS -->
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <a class="nav-link active" data-toggle="tab" href="#tab-cart">1. Cart</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab" href="#tab-info">2. Info</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab" href="#tab-payment">3. Payment</a>
            </li>
        </ul>

        <form asp-action="ViewCart" asp-controller="Order" method="post">
            @Html.AntiForgeryToken()

            <div class="tab-content">

                <!-- ================= CART ================= -->
                <div class="tab-pane fade show active" id="tab-cart">

                    <!-- DESKTOP TABLE -->
                    <div class="table-responsive d-none d-md-block">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center">Price</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-center">Total</th>
                                    <th class="text-center">Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in cartItems)
                                {
                                    @* totalamount += item.ItemCost; *@
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@Url.Content(item.ItemPhotoPath)"
                                                     style="width:80px;height:80px;object-fit:cover;margin-right:10px;" />
                                                <div>
                                                    <strong>@item.StockItemTitle</strong><br />
                                                    <small>@item.ItemSize</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">₹ @item.UnitPrice</td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-light"
                                                    onclick="updateQty(@item.CartItemId,'@item.ItemType',-1)">
                                                −
                                            </button>
                                            <span class="mx-2">@item.Qty</span>
                                            <button type="button" class="btn btn-sm btn-light"
                                                    onclick="updateQty(@item.CartItemId,'@item.ItemType',1)">
                                                +
                                            </button>
                                        </td>
                                        <td class="text-center">₹ @item.ItemCost</td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-danger"
                                                    onclick="removeItem(@item.CartItemId,'@item.ItemType')">
                                                ✖
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- MOBILE CARDS -->
                    <div class="d-md-none">
                        @foreach (var item in cartItems)
                        {
                            @* totalamount += item.ItemCost; *@
                            <div class="card mb-2">
                                <div class="card-body">
                                    <div class="d-flex">
                                        <img src="@Url.Content(item.ItemPhotoPath)"
                                             style="width:70px;height:70px;object-fit:cover;margin-right:10px;" />
                                        <div>
                                            <strong>@item.StockItemTitle</strong><br />
                                            <small>@item.ItemSize</small><br />
                                            <span>₹ @item.UnitPrice</span>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <div>
                                            <button type="button" class="btn btn-sm btn-light"
                                                    onclick="updateQty(@item.CartItemId,'@item.ItemType',-1)">
                                                −
                                            </button>
                                            <span class="mx-2">@item.Qty</span>
                                            <button type="button" class="btn btn-sm btn-light"
                                                    onclick="updateQty(@item.CartItemId,'@item.ItemType',1)">
                                                +
                                            </button>
                                        </div>
                                        <strong>₹ @item.ItemCost</strong>
                                    </div>

                                    <button type="button"
                                            class="btn btn-sm btn-danger btn-block mt-2"
                                            onclick="removeItem(@item.CartItemId,'@item.ItemType')">
                                        Remove
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="text-right mt-3">
                        <strong>Total: ₹ @totalamount</strong><br />
                        <a class="btn btn-theme mt-2" data-toggle="tab" href="#tab-info">Checkout →</a>
                    </div>
                </div>

                <!-- ================= INFO ================= -->
                <div class="tab-pane fade" id="tab-info">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Order Type</label>
                            <select asp-for="OrderTypeId" class="form-control" required>
                                <option value="">-- Select Order Type --</option>
                                @foreach (var ot in Model.OrderTypes)
                                {
                                    <option value="@ot.Value">@ot.Text</option>
                                }
                            </select>

                            <label class="mt-3">Delivery Address</label>
                          
                            <select asp-for="UserAddressId" class="form-control" required>
                                <option value="">-- Select Address --</option>
                                @foreach (var ad in Model.Addresses)
                                {
                                    <option value="@ad.Value">@ad.Text</option>
                                }
                            </select>

                            <div class="form-group">
                                <a asp-controller="Setting"
                                   asp-action="List_UserAddress"
                                   class="btn btn-outline-primary btn-sm">
                                    + Add Address
                                </a>
                            </div>

                        </div>

                        <div class="col-md-6 mb-3">
                            <label>First Name</label>
                            <input asp-for="FirstName" class="form-control mb-2" />

                            <label>Last Name</label>
                            <input asp-for="LastName" class="form-control mb-2" />

                            <label>Mobile Number</label>
                            <input asp-for="ContactNo" class="form-control mb-2" />
                        </div>

                        <div class="col-12 text-right">
                            <a class="btn btn-theme" data-toggle="tab" href="#tab-payment">Continue →</a>
                        </div>
                    </div>
                </div>

                <!-- ================= PAYMENT ================= -->
                <div class="tab-pane fade" id="tab-payment">
                    <div class="card">
                        <div class="card-body">
                            <h5>Payment Method</h5>

                            <div class="form-check mt-2">
                                <input class="form-check-input"
                                       type="radio"
                                       name="PaymentMode"
                                       value="COD"
                                       checked />
                                <label class="form-check-label">
                                    Cash on Delivery
                                </label>
                            </div>

                            <div class="form-check mt-2">
                                <input class="form-check-input"
                                       type="radio"
                                       name="PaymentMode"
                                       value="UPI"
                                       id="upiRadio" />
                                <label class="form-check-label">
                                    Pay via UPI (Google Pay / PhonePe / Paytm)
                                </label>
                            </div>

                            <div id="upiBox" class="mt-3 p-3 border rounded" style="display:none;">
                                <p class="mb-1"><strong>UPI ID:</strong> aslıhalwai@upi</p>
                                <p class="mb-2 text-muted">Pay and enter UTR below</p>

                                <img src="~/images/upi-qr.jpeg"
                                     style="width:200px"
                                     alt="UPI QR Code" />

                                <div class="mt-2">
                                    <input type="text"
                                           name="PaymentUTR"
                                           class="form-control"
                                           placeholder="Enter UPI Transaction ID (UTR)" />
                                </div>
                            </div>


                            <hr />

                            <h5>Total Payable: ₹ @totalamount</h5>

                            <button type="submit"
                                    class="btn btn-success btn-lg btn-block mt-3">
                                PLACE ORDER
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function updateQty(cartItemId, itemType, change) {
            $.post('/Order/UpdateQty', { cartItemId, itemType, change }, function (res) {
                if (res === true) location.reload();
            });
        }

        function removeItem(cartItemId, itemType) {
            if (!confirm("Remove item from cart?")) return;
            $.post('/Order/RemoveItem', { cartItemId, itemType }, function (res) {
                if (res === true) location.reload();
            });
        }

           
        document.querySelectorAll('input[name="PaymentMode"]').forEach(radio => {
            radio.addEventListener('change', function () {
                const upiBox = document.getElementById('upiBox');
                if (!upiBox) return;

                upiBox.style.display = this.value === 'UPI'
                    ? 'block'
                    : 'none';
            });
        });
    


         
        $('form').on('submit', function () {
            const paymentMode = $('input[name="PaymentMode"]:checked').val();

            if (paymentMode === 'UPI') {
                const utr = $('input[name="PaymentUTR"]').val();
                if (!utr || utr.length < 6) {
                    alert('Please enter valid UPI Transaction ID (UTR)');
                    return false;
                }
            }
            return true;
        });
   

    </script>
}
