@{
    ViewData["Title"] = "Order Confirmed - AsliHalwai";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 text-center">
            <div class="ah-cart-card py-5 px-4 shadow-lg text-center" style="border-radius: var(--ah-radius-xl);">
                <div class="mb-4">
                    <div style="width: 80px; height: 80px; background: #dcfce7; color: #16a34a; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 38px; box-shadow: 0 8px 20px rgba(22, 163, 74, 0.2);">
                        <i class="icofont icofont-check-alt"></i>
                    </div>
                </div>

                <h2 class="font-weight-bold mb-2" style="color: #0f172a; font-size: 28px;">
                    Order Confirmed!
                </h2>
                <p class="text-muted mb-4" style="font-size: 15px; line-height: 1.6;">
                    Thank you for your order. Our halwai chefs are preparing your authentic delicacies with pure desi ghee and fresh ingredients.
                </p>

                <div class="p-3 mb-4 rounded text-left" style="background: #f8fafc; border: 1px solid #edf2f7; font-size: 13.5px;">
                    <div class="d-flex align-items-center mb-2">
                        <i class="icofont icofont-fast-delivery text-primary mr-2" style="font-size: 18px;"></i>
                        <span>Expected delivery in <strong>35 – 45 mins</strong></span>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="icofont icofont-info-circle text-info mr-2" style="font-size: 18px;"></i>
                        <span>You can view and track your order in your customer dashboard.</span>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                    <a asp-controller="User" asp-action="Dashboard" class="btn ah-btn-primary mb-2 mb-sm-0 mr-sm-2" style="display: inline-flex; width: auto; padding: 12px 24px;">
                        <i class="icofont icofont-dashboard"></i> View Order Dashboard
                    </a>
                    <a asp-controller="Home" asp-action="AllItems" class="btn ah-btn-secondary" style="display: inline-flex; width: auto; padding: 12px 24px;">
                        Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
