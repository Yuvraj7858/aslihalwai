@model OrderDetailsVM

@{
    ViewData["Title"] = "Order #" + Model.OrderId + " Details";

    var steps = new List<string>
    {
        "Pending",
        "Accept",
        "On the way",
        "Delivered"
    };

    bool isCancelled = Model.Status == "Cancelled";
    int currentIndex = steps.IndexOf(Model.Status);
}

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent p-0 mb-1" style="font-size: 13px;">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="User" asp-action="Dashboard">Orders</a></li>
                    <li class="breadcrumb-item active text-muted" aria-current="page">Order #@Model.OrderId</li>
                </ol>
            </nav>
            <h3 class="font-weight-bold mb-1" style="color: #0f172a;">
                Order #@Model.OrderId
            </h3>
            <p class="text-muted mb-0" style="font-size: 14px;">
                Placed on <strong>@Model.OrderDate.ToString("dd MMMM yyyy, hh:mm tt")</strong>
            </p>
        </div>

        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a class="btn ah-btn-secondary mr-2"
               asp-controller="Order"
               asp-action="Invoice"
               asp-route-id="@Model.OrderId"
               target="_blank">
                <i class="icofont icofont-file-document"></i> View Invoice
            </a>
            <a asp-controller="User" asp-action="Dashboard" class="btn btn-outline-secondary" style="border-radius: var(--ah-radius-pill);">
                Back to Dashboard
            </a>
        </div>
    </div>

    <!-- ================= ORDER STATUS TIMELINE ================= -->
    <div class="ah-cart-card mb-4">
        <h5 class="font-weight-bold mb-3" style="color: #1e293b;">
            <i class="icofont icofont-delivery-time text-primary"></i> Order Tracking
        </h5>

        @if (isCancelled)
        {
            <div class="alert alert-danger text-center font-weight-bold py-3 mb-0" style="border-radius: var(--ah-radius-md);">
                <i class="icofont icofont-close-circled"></i> This order has been Cancelled.
            </div>
        }
        else
        {
            <div class="timeline py-2">
                @for (int i = 0; i < steps.Count; i++)
                {
                    var isCompleted = i <= currentIndex;
                    var isCurrent = i == currentIndex;

                    <div class="timeline-step @(isCompleted ? "active" : "")">
                        <div class="circle" style="@(isCompleted ? "background: #16a34a; box-shadow: 0 4px 10px rgba(22,163,74,0.3);" : "background: #e2e8f0; color: #64748b;")">
                            @if (isCompleted)
                            {
                                <i class="icofont icofont-check"></i>
                            }
                            else
                            {
                                <span>@(i + 1)</span>
                            }
                        </div>
                        <div class="timeline-label font-weight-bold @(isCurrent ? "text-dark" : "text-muted")" style="font-size: 13px;">
                            @steps[i]
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="row">
        <!-- ================= ORDER ITEMS ================= -->
        <div class="col-lg-8 mb-4">
            <div class="ah-cart-card">
                <h5 class="font-weight-bold mb-3" style="color: #1e293b;">
                    <i class="icofont icofont-restaurant text-primary"></i> Items in this Order
                </h5>

                <!-- Desktop Table -->
                <div class="table-responsive d-none d-md-block">
                    <table class="table ah-cart-table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-center">Unit Price</th>
                                <th class="text-right">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@item.PhotoPath"
                                                 class="rounded mr-3"
                                                 style="width: 55px; height: 55px; object-fit: cover; border: 1px solid #f1f5f9;"
                                                 onerror="this.src='/uploads/no-image.png'" />
                                            <strong style="color: #0f172a; font-size: 14.5px;">@item.ProductName</strong>
                                        </div>
                                    </td>
                                    <td class="text-center font-weight-bold">
                                        &times; @item.Qty
                                    </td>
                                    <td class="text-center font-weight-bold" style="color: #475569;">
                                        ₹ @item.UnitPrice
                                    </td>
                                    <td class="text-right font-weight-bold" style="color: var(--ah-primary); font-size: 15px;">
                                        ₹ @(item.UnitPrice * item.Qty)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Cards -->
                <div class="d-md-none">
                    @foreach (var item in Model.Items)
                    {
                        <div class="order-item-card">
                            <img src="@item.PhotoPath"
                                 onerror="this.src='/uploads/no-image.png'" />

                            <div class="order-item-info">
                                <h6>@item.ProductName</h6>
                                <small>Qty: @item.Qty &times; ₹ @item.UnitPrice</small>
                                <div class="order-item-total">
                                    Total: ₹ @(item.UnitPrice * item.Qty)
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Cancel Order Option if Pending -->
                @if (Model.Status == "Pending")
                {
                    <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Need to make changes?</span>
                        <form asp-controller="Order"
                              asp-action="CancelOrder"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to cancel this order?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderId" value="@Model.OrderId" />
                            <button type="submit" class="btn btn-outline-danger btn-sm" style="border-radius: var(--ah-radius-pill); font-weight: 600;">
                                <i class="icofont icofont-close-circled"></i> Cancel Order
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>

        <!-- ================= PAYMENT & BILL SUMMARY ================= -->
        <div class="col-lg-4">
            <div class="ah-cart-card">
                <h5 class="font-weight-bold mb-3" style="color: #1e293b;">Payment Information</h5>

                <div class="d-flex justify-content-between mb-2" style="font-size: 14px;">
                    <span class="text-muted">Payment Mode:</span>
                    <strong class="text-dark">@Model.PaymentMode</strong>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2" style="font-size: 14px;">
                    <span class="text-muted">Payment Status:</span>
                    @if (Model.PaymentStatus == "Paid")
                    {
                        <span class="badge badge-success px-2 py-1">Paid</span>
                    }
                    else if (Model.PaymentStatus == "Pending")
                    {
                        <span class="badge badge-warning px-2 py-1">Pending Verification</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary px-2 py-1">@Model.PaymentStatus</span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.PaymentUTR))
                {
                    <div class="d-flex justify-content-between mb-3" style="font-size: 13.5px;">
                        <span class="text-muted">Transaction UTR:</span>
                        <span class="badge badge-light border text-monospace">@Model.PaymentUTR</span>
                    </div>
                }

                <hr />

                @{
                    decimal orderSubtotal = Model.Items.Sum(x => x.UnitPrice * x.Qty);
                }
                <div class="d-flex justify-content-between mb-2" style="font-size: 14px; color: #64748b;">
                    <span>Subtotal</span>
                    <span class="font-weight-bold text-dark">₹ @orderSubtotal</span>
                </div>
                <div class="d-flex justify-content-between mb-3" style="font-size: 14px; color: #64748b;">
                    <span>Delivery Fee</span>
                    <span class="text-success font-weight-bold">FREE</span>
                </div>

                <div class="d-flex justify-content-between pt-2 border-top">
                    <span class="font-weight-bold" style="font-size: 16px;">Total Paid / Due</span>
                    <strong style="font-size: 20px; color: var(--ah-primary);">₹ @orderSubtotal</strong>
                </div>
            </div>
        </div>
    </div>
</div>
