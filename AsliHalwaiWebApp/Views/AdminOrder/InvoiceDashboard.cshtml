@model AsliHalwaiWebApp.ViewModel.AdminOrderFilterVM

@{
    ViewData["Title"] = "Admin Invoice Dashboard - AsliHalwai";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <h3 class="font-weight-bold mb-1" style="color: #0f172a;">🧾 Admin &ndash; Invoice Dashboard</h3>
            <p class="text-muted mb-0 small">
                Search, filter, print invoices and verify UPI payments.
            </p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: var(--ah-radius-pill);">
                Manage Live Orders
            </a>
        </div>
    </div>

    <!-- 🔍 FILTER FORM -->
    <div class="ah-dish-card p-3 p-md-4 mb-4">
        <form method="get">
            <div class="row align-items-end">
                <div class="col-md-3 col-6 mb-2">
                    <label class="font-weight-bold small text-muted">Order #</label>
                    <input type="number"
                           name="orderId"
                           value="@Model.OrderId"
                           class="form-control"
                           placeholder="e.g. 104"
                           style="height: 42px; border-radius: var(--ah-radius-md);" />
                </div>

                <div class="col-md-3 col-6 mb-2">
                    <label class="font-weight-bold small text-muted">Customer Name</label>
                    <input type="text"
                           name="customerName"
                           value="@Model.CustomerName"
                           class="form-control"
                           placeholder="Search customer"
                           style="height: 42px; border-radius: var(--ah-radius-md);" />
                </div>

                <div class="col-md-3 col-6 mb-2">
                    <label class="font-weight-bold small text-muted">Order Status</label>
                    <select name="statusId" class="form-control" style="height: 42px; border-radius: var(--ah-radius-md);">
                        <option value="">-- All Statuses --</option>
                        @foreach (var s in ViewBag.StatusList)
                        {
                            <option value="@s.OrderStatusId"
                                    selected="@(Model.OrderStatusId == s.OrderStatusId)">
                                @s.OrderStatus
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3 col-6 mb-2 d-flex gap-2">
                    <button type="submit" class="btn ah-btn-pill-primary flex-fill mr-2" style="height: 42px; padding: 0 16px;">
                        <i class="icofont icofont-search"></i> Search
                    </button>
                    <a asp-action="InvoiceDashboard"
                       class="btn btn-outline-secondary" style="border-radius: var(--ah-radius-pill); height: 42px; display: inline-flex; align-items: center; justify-content: center;">
                        Reset
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- ================= DESKTOP TABLE ================= -->
    <div class="ah-dish-card p-3 p-md-4 d-none d-md-block mb-4">
        <div class="table-responsive">
            <table class="table ah-cart-table">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Contact</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th>Payment</th>
                        <th>UTR</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Orders.Any())
                    {
                        @foreach (var o in Model.Orders)
                        {
                            <tr>
                                <td><strong class="text-dark">#@o.OrderId</strong></td>
                                <td>@o.OrderDate.ToString("dd MMM yyyy")</td>
                                <td>@o.CustomerName</td>
                                <td>@o.ContactNo</td>

                                <td>
                                    <span class="badge @(o.OrderStatus == "Delivered" ? "badge-success" : o.OrderStatus == "Pending" ? "badge-warning" : "badge-info")">
                                        @o.OrderStatus
                                    </span>
                                </td>

                                <td><strong class="text-dark">₹ @o.TotalAmount</strong></td>

                                <td>
                                    <span class="badge @(o.PaymentStatus == "Paid" ? "badge-success" : "badge-warning")">
                                        @o.PaymentMode (@o.PaymentStatus)
                                    </span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(o.PaymentUTR))
                                    {
                                        <code class="text-monospace">@o.PaymentUTR</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td class="text-right">
                                    <a asp-controller="Order"
                                       asp-action="Invoice"
                                       asp-route-id="@o.OrderId"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-dark mr-1"
                                       style="border-radius: var(--ah-radius-pill);">
                                        <i class="icofont icofont-print"></i> Invoice
                                    </a>

                                    @if (o.PaymentMode == "UPI" && o.PaymentStatus == "Pending")
                                    {
                                        <form asp-action="MarkPaid" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="orderId" value="@o.OrderId" />
                                            <button class="btn btn-sm btn-success" style="border-radius: var(--ah-radius-pill);">
                                                ✔ Mark Paid
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No orders found matching criteria.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ================= MOBILE CARD VIEW ================= -->
    <div class="d-block d-md-none">
        @if (Model.Orders.Any())
        {
            @foreach (var o in Model.Orders)
            {
                <div class="ah-dish-card p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong style="font-size: 16px; color: #111827;">Order #@o.OrderId</strong>
                        <span class="badge @(o.OrderStatus == "Delivered" ? "badge-success" : "badge-info")">@o.OrderStatus</span>
                    </div>

                    <p class="mb-1 small text-muted"><strong>Customer:</strong> @o.CustomerName (@o.ContactNo)</p>
                    <p class="mb-1 small text-muted"><strong>Date:</strong> @o.OrderDate.ToString("dd MMM yyyy")</p>
                    <p class="mb-2 small"><strong>Total Amount:</strong> <span class="font-weight-bold" style="color: var(--ah-primary);">₹ @o.TotalAmount</span></p>

                    <div class="mb-3">
                        <span class="badge @(o.PaymentStatus == "Paid" ? "badge-success" : "badge-warning")">
                            @o.PaymentMode (@o.PaymentStatus)
                        </span>
                        @if (!string.IsNullOrEmpty(o.PaymentUTR))
                        {
                            <span class="small ml-2 text-muted">UTR: <code>@o.PaymentUTR</code></span>
                        }
                    </div>

                    <div class="pt-2 border-top d-flex gap-2">
                        <a asp-controller="Order"
                           asp-action="Invoice"
                           asp-route-id="@o.OrderId"
                           target="_blank"
                           class="btn btn-outline-dark btn-block mr-2"
                           style="border-radius: var(--ah-radius-pill); font-weight: 700;">
                            <i class="icofont icofont-print"></i> Invoice
                        </a>

                        @if (o.PaymentMode == "UPI" && o.PaymentStatus == "Pending")
                        {
                            <form asp-action="MarkPaid" method="post" class="flex-fill">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@o.OrderId" />
                                <button class="btn btn-success btn-block" style="border-radius: var(--ah-radius-pill); font-weight: 700;">
                                    ✔ Mark Paid
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-secondary text-center">
                No orders found
            </div>
        }
    </div>
</div>
