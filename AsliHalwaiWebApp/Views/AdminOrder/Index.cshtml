@model IEnumerable<AsliHalwaiWebApp.ViewModel.AdminOrderVM>

@{
    ViewData["Title"] = "Admin Order Management - AsliHalwai";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <h3 class="font-weight-bold mb-1" style="color: #0f172a;">Admin &ndash; Order Management</h3>
            <p class="text-muted mb-0 small">
                Monitor and update incoming customer food orders in real-time.
            </p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-action="InvoiceDashboard" class="btn ah-btn-pill-primary">
                🧾 Invoice Dashboard
            </a>
        </div>
    </div>

    <!-- ================= DESKTOP TABLE ================= -->
    <div class="ah-dish-card p-3 p-md-4 d-none d-md-block mb-4">
        <div class="table-responsive">
            <table class="table ah-cart-table">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Order Date</th>
                        <th>Live Status</th>
                        <th style="width:260px" class="text-right">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td><strong class="text-dark">#@o.OrderId</strong></td>
                            <td>@o.UserName</td>
                            <td>@o.OrderDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (o.Status == "Pending")
                                {
                                    <span class="badge badge-warning px-2 py-1">Pending</span>
                                }
                                else if (o.Status == "Accept")
                                {
                                    <span class="badge badge-info px-2 py-1">Preparing</span>
                                }
                                else if (o.Status == "On the way")
                                {
                                    <span class="badge badge-primary px-2 py-1">On the way</span>
                                }
                                else if (o.Status == "Delivered")
                                {
                                    <span class="badge badge-success px-2 py-1">Delivered</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary px-2 py-1">@o.Status</span>
                                }
                            </td>

                            <td class="text-right">
                                @if (o.Status == "Pending")
                                {
                                    <form asp-action="Approve" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@o.OrderId" />
                                        <button class="btn btn-sm btn-success" style="border-radius: var(--ah-radius-pill);">Accept</button>
                                    </form>

                                    <form asp-action="Cancel" method="post" class="d-inline"
                                          onsubmit="return confirm('Cancel this order?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@o.OrderId" />
                                        <button class="btn btn-sm btn-outline-danger" style="border-radius: var(--ah-radius-pill);">Cancel</button>
                                    </form>
                                }
                                else if (o.Status == "Accept")
                                {
                                    <form asp-action="MarkOnTheWay" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@o.OrderId" />
                                        <button class="btn btn-sm btn-warning" style="border-radius: var(--ah-radius-pill);">On the way</button>
                                    </form>

                                    <form asp-action="Cancel" method="post" class="d-inline"
                                          onsubmit="return confirm('Cancel this order?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@o.OrderId" />
                                        <button class="btn btn-sm btn-outline-danger" style="border-radius: var(--ah-radius-pill);">Cancel</button>
                                    </form>
                                }
                                else if (o.Status == "On the way")
                                {
                                    <form asp-action="MarkDelivered" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@o.OrderId" />
                                        <button class="btn btn-sm btn-primary" style="border-radius: var(--ah-radius-pill);">Delivered</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">No Action</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ================= MOBILE CARD VIEW ================= -->
    <div class="d-block d-md-none">
        @if (Model.Any())
        {
            @foreach (var o in Model)
            {
                <div class="ah-dish-card p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong style="font-size: 16px; color: #111827;">Order #@o.OrderId</strong>
                        <span class="badge @(o.Status == "Pending" ? "badge-warning" : "badge-info")">@o.Status</span>
                    </div>

                    <p class="mb-1 small text-muted">
                        <strong>Customer:</strong> @o.UserName
                    </p>

                    <p class="mb-3 small text-muted">
                        <strong>Date:</strong> @o.OrderDate.ToString("dd MMM yyyy")
                    </p>

                    <!-- ACTIONS -->
                    <div class="d-flex flex-column gap-2 pt-2 border-top">
                        @if (o.Status == "Pending")
                        {
                            <form asp-action="Approve" method="post" class="mb-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@o.OrderId" />
                                <button class="btn btn-success btn-block" style="border-radius: var(--ah-radius-pill); font-weight: 700;">
                                    Accept Order
                                </button>
                            </form>

                            <form asp-action="Cancel" method="post"
                                  onsubmit="return confirm('Cancel this order?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@o.OrderId" />
                                <button class="btn btn-outline-danger btn-block" style="border-radius: var(--ah-radius-pill); font-weight: 700;">
                                    Cancel Order
                                </button>
                            </form>
                        }
                        else if (o.Status == "Accept")
                        {
                            <form asp-action="MarkOnTheWay" method="post" class="mb-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@o.OrderId" />
                                <button class="btn btn-warning btn-block" style="border-radius: var(--ah-radius-pill); font-weight: 700;">
                                    Mark On the way
                                </button>
                            </form>

                            <form asp-action="Cancel" method="post"
                                  onsubmit="return confirm('Cancel this order?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@o.OrderId" />
                                <button class="btn btn-outline-danger btn-block" style="border-radius: var(--ah-radius-pill); font-weight: 700;">
                                    Cancel Order
                                </button>
                            </form>
                        }
                        else if (o.Status == "On the way")
                        {
                            <form asp-action="MarkDelivered" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@o.OrderId" />
                                <button class="btn btn-primary btn-block" style="border-radius: var(--ah-radius-pill); font-weight: 700;">
                                    Mark Delivered
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="text-muted text-center small">
                                Completed
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-secondary text-center">
                No orders found
            </div>
        }
    </div>
</div>
