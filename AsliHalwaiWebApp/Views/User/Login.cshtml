@model AsliHalwaiWebApp.ViewModels.LoginVM

@{
    ViewData["Title"] = "Login to AsliHalwai";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7 col-12">
            <div class="ah-auth-card">
                <div class="ah-auth-header">
                    <img src="~/Template/assets/images/logo/logo.png" alt="AsliHalwai" />
                    <h3 class="ah-auth-title">Welcome Back</h3>
                    <p class="ah-auth-desc">Sign in to order your favourite sweets &amp; track deliveries</p>
                </div>

                <form asp-action="Login" asp-controller="User" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" style="border-radius: var(--ah-radius-md);"></div>

                    <!-- Username / Email -->
                    <div class="ah-input-group">
                        <i class="icofont icofont-ui-user"></i>
                        <input asp-for="UserName"
                               class="form-control"
                               placeholder="Email Address or Mobile Number"
                               required />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <!-- Password -->
                    <div class="ah-input-group">
                        <i class="icofont icofont-lock"></i>
                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="Enter Password"
                               required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Remember & Forgot Password -->
                    <div class="d-flex justify-content-between align-items-center mb-4" style="font-size: 13.5px;">
                        <label class="d-flex align-items-center mb-0 text-muted" style="cursor: pointer;">
                            <input type="checkbox" class="mr-2" /> Remember Me
                        </label>
                        <a asp-controller="AccountRecovery"
                           asp-action="AccountRecovery"
                           class="font-weight-bold" style="color: var(--ah-primary);">
                            Forgot Password?
                        </a>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn ah-btn-primary mb-3">
                        <i class="icofont icofont-sign-in"></i> Sign In to Account
                    </button>

                    <!-- Switch to Register -->
                    <div class="text-center mt-3 pt-3 border-top" style="font-size: 14px;">
                        <span class="text-muted">Don't have an account?</span>
                        <a asp-controller="User" asp-action="Register" class="font-weight-bold ml-1" style="color: var(--ah-primary);">
                            Create Free Account
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
