@model AsliHalwaiWebApp.ViewModels.Reg_UserVM

@{
    ViewData["Title"] = "Create Account - AsliHalwai";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7 col-12">
            <div class="ah-auth-card">
                <div class="ah-auth-header">
                    <img src="~/Template/assets/images/logo/logo.png" alt="AsliHalwai" />
                    <h3 class="ah-auth-title">Create an Account</h3>
                    <p class="ah-auth-desc">Join AsliHalwai for fast ordering, table bookings &amp; exclusive deals</p>
                </div>

                <form asp-action="Register" asp-controller="User" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" style="border-radius: var(--ah-radius-md);"></div>

                    <!-- Email / Phone -->
                    <div class="ah-input-group">
                        <i class="icofont icofont-ui-user"></i>
                        <input asp-for="UserName"
                               class="form-control"
                               placeholder="Email Address or Phone Number"
                               required />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <!-- Password -->
                    <div class="ah-input-group">
                        <i class="icofont icofont-lock"></i>
                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="Create Password"
                               required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="ah-input-group">
                        <i class="icofont icofont-shield-check"></i>
                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control"
                               placeholder="Confirm Password"
                               required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn ah-btn-primary mb-3">
                        <i class="icofont icofont-ui-add"></i> Create My Account
                    </button>

                    <!-- Switch to Login -->
                    <div class="text-center mt-3 pt-3 border-top" style="font-size: 14px;">
                        <span class="text-muted">Already have an account?</span>
                        <a asp-controller="User" asp-action="Login" class="font-weight-bold ml-1" style="color: var(--ah-primary);">
                            Sign In Here
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
