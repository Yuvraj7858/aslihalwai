@model AsliHalwaiWebApp.ViewModel.StockItemCategoryVM

@{
    ViewData["Title"] = "Stock Item Categories - AsliHalwai Admin";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent p-0 mb-1" style="font-size: 13px;">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="AdminOrder" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item active text-muted" aria-current="page">Item Categories</li>
                </ol>
            </nav>
            <h3 class="font-weight-bold mb-1" style="color: #0f172a;">Stock Item Categories</h3>
            <p class="text-muted mb-0 small">
                Manage specific product classifications and their display statuses.
            </p>
        </div>
    </div>

    <div class="row">
        <!-- ===== LEFT : ADD / EDIT FORM ===== -->
        <div class="col-md-4 mb-4">
            <div class="ah-dish-card p-3 p-md-4">
                <h5 class="font-weight-bold mb-3" style="color: #111827;">
                    @(Model.StockItemCategoryId == 0 ? "Add Item Category" : "Edit Item Category")
                </h5>

                <form asp-action="StockItemCategory" asp-controller="Stock" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="StockItemCategoryId" />

                    <div class="form-group mb-3">
                        <label class="font-weight-bold small text-muted">Category Name *</label>
                        <input asp-for="StockItemCategory"
                               class="form-control"
                               placeholder="e.g. Desi Ghee Sweets"
                               required
                               style="height: 44px; border-radius: var(--ah-radius-md);" />
                        <span asp-validation-for="StockItemCategory" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label class="font-weight-bold small text-muted">Visible Status *</label>
                        <select asp-for="VisibleStatusId"
                                asp-items="Model.VisibleStatusList"
                                class="form-control"
                                required
                                style="height: 44px; border-radius: var(--ah-radius-md);">
                            <option value="">-- Select Status --</option>
                        </select>
                        <span asp-validation-for="VisibleStatusId" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        @if (Model.StockItemCategoryId > 0)
                        {
                            <a asp-action="StockItemCategory" class="btn btn-outline-secondary" style="border-radius: var(--ah-radius-pill);">
                                Cancel
                            </a>
                        }
                        <button type="submit" class="btn ah-btn-pill-primary">
                            @(Model.StockItemCategoryId == 0 ? "Save Category" : "Update")
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- ===== RIGHT : CATEGORY LIST ===== -->
        <div class="col-md-8">
            <div class="ah-dish-card p-3 p-md-4">
                <h5 class="font-weight-bold mb-3" style="color: #111827;">Stock Item Category List</h5>

                <div class="table-responsive">
                    <table class="table ah-cart-table">
                        <thead>
                            <tr>
                                <th>Category Name</th>
                                <th>Status ID</th>
                                <th style="width:160px" class="text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.CategoryList != null && Model.CategoryList.Any())
                            {
                                foreach (var item in Model.CategoryList)
                                {
                                    <tr>
                                        <td><strong class="text-dark">@item.StockItemCategory</strong></td>
                                        <td><span class="badge badge-light">@item.VisibleStatusId</span></td>
                                        <td class="text-right">
                                            <a asp-controller="Stock"
                                               asp-action="StockItemCategory"
                                               asp-route-id="@item.StockItemCategoryId"
                                               class="btn btn-sm btn-outline-primary mr-1"
                                               style="border-radius: var(--ah-radius-pill);">
                                                Edit
                                            </a>

                                            <form asp-controller="Stock"
                                                  asp-action="DeleteStockItemCategory"
                                                  method="post"
                                                  style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.StockItemCategoryId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        style="border-radius: var(--ah-radius-pill);"
                                                        onclick="return confirm('Delete this category?')">
                                                    Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">
                                        No Categories Found
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
