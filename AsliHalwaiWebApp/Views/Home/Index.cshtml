@model AsliHalwaiWebApp.ViewModel.HomeVM
@{
    ViewData["Title"] = "Real Taste, Right at Your Doorstep";
}

<div class="container py-2">
    <!-- ================= 1. HERO SECTION (Warm Banner with Bowl & Search) ================= -->
    <section class="ah-hero-card">
        <div class="row align-items-center">
            <!-- Left Column: Copy & Search -->
            <div class="col-lg-7 col-md-12 mb-4 mb-lg-0">
                <span class="ah-hero-subtag">Good Food &bull; Good Mood</span>
                <h1 class="ah-hero-headline">
                    Real Taste,<br />
                    <span>Right at Your Doorstep</span>
                </h1>
                <p class="ah-hero-description">
                    Fresh Sweets, Snacks &amp; More &mdash; From AsliHalwai to Your Home.
                </p>

                <!-- Search Bar Pill -->
                <form class="ah-hero-search" asp-controller="Home" asp-action="AllItems" method="post">
                    @Html.AntiForgeryToken()
                    <i class="icofont icofont-location-pin"></i>
                    <input type="text" name="SearchKey" placeholder="Enter your delivery location or sweets name..." />
                    <button type="submit">
                        <span>Find Food</span> <i class="icofont icofont-arrow-right"></i>
                    </button>
                </form>

                <!-- 4 Trust Badges -->
                <div class="ah-hero-features">
                    <div class="ah-feature-chip">
                        <i class="icofont icofont-leaf text-success"></i>
                        <span>Freshly Prepared</span>
                    </div>
                    <div class="ah-feature-chip">
                        <i class="icofont icofont-shield-alt text-success"></i>
                        <span>Hygienic &amp; Safe</span>
                    </div>
                    <div class="ah-feature-chip">
                        <i class="icofont icofont-fast-delivery text-danger"></i>
                        <span>Fast Delivery</span>
                    </div>
                    <div class="ah-feature-chip">
                        <i class="icofont icofont-heart text-danger"></i>
                        <span>Authentic Taste</span>
                    </div>
                </div>
            </div>

            <!-- Right Column: Visual Showcase -->
            <div class="col-lg-5 col-md-12 text-center">
                <div class="ah-hero-visual">
                    <!-- Main Bowl Photo -->
                    <img src="~/uploads/stock/13fd404c-f653-4587-931f-1c22fab8bdee.jpg"
                         alt="Fresh Gulab Jamun"
                         class="ah-hero-bowl-img"
                         onerror="this.src='/Template/assets/images/background/banner-1.jpg'" />

                    <!-- Floating Cursive Note -->
                    <div class="ah-floating-cursive d-none d-sm-block">
                        Sweets That<br />Bring Smiles &hearts;
                    </div>

                    <!-- Floating 100% Pure Circle Badge -->
                    <div class="ah-floating-fresh-badge">
                        <span>100%</span>
                        PURE &amp; FRESH
                    </div>
                </div>

                <!-- Slider Dots Indicator -->
                <div class="text-center mt-3" style="color: var(--ah-primary); font-size: 20px; letter-spacing: 4px;">
                    &bull; <span style="opacity: 0.3;">&bull;</span> <span style="opacity: 0.3;">&bull;</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= 2. "WHAT WOULD YOU LIKE TO HAVE?" (Circular Rail) ================= -->
    <section class="py-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="font-weight-bold mb-0" style="font-size: 22px; color: #111827;">What would you like to have?</h3>
            <a asp-controller="Home" asp-action="AllItems" class="font-weight-bold" style="font-size: 13.5px; color: var(--ah-primary);">
                View all <i class="icofont icofont-arrow-right"></i>
            </a>
        </div>

        <div class="ah-cat-rail">
            <a asp-controller="Home" asp-action="AllItems" class="ah-cat-item">
                <div class="ah-cat-circle" style="background: #fef2f2;">
                    <img src="~/uploads/stock/13fd404c-f653-4587-931f-1c22fab8bdee.jpg" alt="Sweets" onerror="this.src='/Template/assets/images/about/1.png'" />
                </div>
                <span class="ah-cat-label">Sweets</span>
            </a>

            <a asp-controller="Home" asp-action="AllItems" class="ah-cat-item">
                <div class="ah-cat-circle" style="background: #fffbeb;">
                    <img src="~/uploads/stock/0dab22b1-e824-4920-b6a0-9ba5447f5fbf.jpg" alt="Namkeen" onerror="this.src='/Template/assets/images/about/2.png'" />
                </div>
                <span class="ah-cat-label">Namkeen</span>
            </a>

            <a asp-controller="Home" asp-action="AllItems" class="ah-cat-item">
                <div class="ah-cat-circle" style="background: #fff7ed;">
                    <img src="~/uploads/stock/f8ea7a2a-ce23-4476-9111-42bde789e025.jpg" alt="Snacks" onerror="this.src='/Template/assets/images/about/3.jpg'" />
                </div>
                <span class="ah-cat-label">Snacks</span>
            </a>

            <a asp-controller="Home" asp-action="AllItems" class="ah-cat-item">
                <div class="ah-cat-circle" style="background: #f0fdf4;">
                    <img src="~/uploads/stock/2db0089f-d48f-41fe-a7eb-279a0b0f707d.jpg" alt="North Indian" onerror="this.src='/Template/assets/images/about/1.png'" />
                </div>
                <span class="ah-cat-label">North Indian</span>
            </a>

            <a asp-controller="Home" asp-action="AllItems" class="ah-cat-item">
                <div class="ah-cat-circle" style="background: #fef3c7;">
                    <img src="~/uploads/stock/56b29ece-8cf2-46e3-b258-e72043f0cf6d.png" alt="Chaat" onerror="this.src='/Template/assets/images/about/2.png'" />
                </div>
                <span class="ah-cat-label">Chaat</span>
            </a>

            <a asp-controller="Home" asp-action="AllItems" class="ah-cat-item">
                <div class="ah-cat-circle" style="background: #fdf2f8;">
                    <img src="~/uploads/stock/f7074921-bd2a-4a41-927e-a67e48b360e4.png" alt="Bakery" onerror="this.src='/Template/assets/images/about/3.jpg'" />
                </div>
                <span class="ah-cat-label">Bakery</span>
            </a>

            <a asp-controller="Home" asp-action="AllItems" class="ah-cat-item">
                <div class="ah-cat-circle" style="background: #eff6ff;">
                    <img src="~/uploads/stock/6a7426e0-7463-4377-ba67-9dab5796ce94.png" alt="Beverages" onerror="this.src='/Template/assets/images/about/1.png'" />
                </div>
                <span class="ah-cat-label">Beverages</span>
            </a>

            <a asp-controller="Home" asp-action="AllItems" class="ah-cat-item">
                <div class="ah-cat-circle" style="background: #faf5ff;">
                    <img src="~/uploads/stock/d86f2cb0-d98a-4b2b-a950-70cfbfae8196.png" alt="Festive Special" onerror="this.src='/Template/assets/images/about/2.png'" />
                </div>
                <span class="ah-cat-label">Festive Special</span>
            </a>
        </div>
    </section>

    <!-- ================= 3. OUR POPULAR DISHES (Exact Reference Cards) ================= -->
    <section class="py-4">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <div>
                <span class="text-uppercase font-weight-bold" style="font-size: 11.5px; color: #ea580c; letter-spacing: 0.08em;">Customer Favorites</span>
                <h3 class="font-weight-bold mb-1" style="font-size: 24px; color: #111827;">Our Popular Dishes</h3>
                <p class="text-muted mb-0 small">Loved by thousands, always fresh, always delicious.</p>
            </div>

            <div class="ah-carousel-nav d-none d-sm-flex">
                <button type="button" class="ah-arrow-btn prev-dish" onclick="$('.dish').trigger('prev.owl.carousel')"><i class="icofont icofont-arrow-left"></i></button>
                <button type="button" class="ah-arrow-btn next-dish" onclick="$('.dish').trigger('next.owl.carousel')"><i class="icofont icofont-arrow-right"></i></button>
            </div>
        </div>

        @if (Model.PopularDishes != null && Model.PopularDishes.Any())
        {
            <div class="dish owl-carousel">
                @{
                    int cardIndex = 0;
                    string[] tags = { "Bestseller", "Most Loved", "Premium", "Trending" };
                    string[] tagClasses = { "ah-tag-bestseller", "ah-tag-loved", "ah-tag-premium", "ah-tag-trending" };
                    string[] times = { "20-30 min", "15-25 min", "15-20 min", "25-35 min" };
                    string[] ratings = { "4.8 (1.3k)", "4.7 (1.1k)", "4.9 (886)", "4.8 (1.9k)" };
                }
                @foreach (var item in Model.PopularDishes)
                {
                    var tag = tags[cardIndex % tags.Length];
                    var tagClass = tagClasses[cardIndex % tagClasses.Length];
                    var time = times[cardIndex % times.Length];
                    var rate = ratings[cardIndex % ratings.Length];
                    cardIndex++;

                    <div class="item p-2">
                        <div class="ah-dish-card">
                            <div class="ah-dish-img-wrap">
                                <span class="@tagClass">@tag</span>
                                <span class="ah-fav-heart"><i class="icofont icofont-heart-alt"></i></span>
                                <a asp-controller="Home" asp-action="ProductDetail" asp-route-itemid="@item.StockItemId">
                                    <img src="@Url.Content(item.ItemPhotoPath)"
                                         alt="@item.StockItemTitle"
                                         class="ah-dish-img"
                                         onerror="this.src='/Template/assets/images/about/3.jpg'" />
                                </a>
                            </div>

                            <a asp-controller="Home" asp-action="ProductDetail" asp-route-itemid="@item.StockItemId" class="text-dark">
                                <h5 class="ah-dish-title" title="@item.StockItemTitle">@item.StockItemTitle</h5>
                            </a>
                            <p class="ah-dish-desc">
                                Handcrafted with 100% pure desi ghee and fresh traditional ingredients.
                            </p>

                            <div class="ah-dish-price-row">
                                <span class="ah-dish-price">₹ @item.UnitPrice</span>
                                <span class="ah-dish-time">@time</span>
                            </div>

                            <div class="ah-dish-footer">
                                <span class="ah-dish-rating">
                                    <i class="fa fa-star"></i> @rate
                                </span>
                                <button type="button" class="ah-btn-add-pill" onclick="addItem(@item.StockItemId)">
                                    Add <i class="icofont icofont-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- ================= 4. MIDDLE FEATURE CTA BANNER ================= -->
    <section class="ah-cta-banner">
        <div>
            <h3 class="ah-cta-title">Authentic Taste Delivered Fresh</h3>
            <div class="ah-cta-badges">
                <span><i class="icofont icofont-badge text-warning"></i> Best Quality</span>
                <span><i class="icofont icofont-leaf text-success"></i> Fresh Ingredients</span>
                <span><i class="icofont icofont-clock-time text-primary"></i> On Time Delivery</span>
            </div>
        </div>

        <div class="mt-3 mt-md-0">
            <a asp-controller="Home" asp-action="AllItems" class="btn ah-btn-pill-primary" style="padding: 12px 32px; font-size: 14.5px;">
                Order Now <i class="icofont icofont-arrow-right"></i>
            </a>
        </div>
    </section>

    <!-- ================= 5. "OUR DELICIOUS MENU" (Tabs + 2-Col Grid + Promo Box) ================= -->
    <section class="py-4" id="menu">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <div>
                <span class="text-uppercase font-weight-bold" style="font-size: 11.5px; color: #ea580c; letter-spacing: 0.08em;">Explore</span>
                <h3 class="font-weight-bold mb-1" style="font-size: 24px; color: #111827;">Our Delicious Menu</h3>
            </div>
            <a asp-controller="Home" asp-action="AllItems" class="font-weight-bold" style="font-size: 13.5px; color: var(--ah-primary);">
                View all Items <i class="icofont icofont-arrow-right"></i>
            </a>
        </div>

        @if (Model.Menu != null && Model.Menu.Any())
        {
            <!-- Category Filter Tabs -->
            <ul class="nav nav-pills mb-4 ah-category-tabs justify-content-start" role="tablist">
                @{
                    bool firstTab = true;
                    foreach (var cat in Model.Menu)
                    {
                        var tabId = "menu_" + cat.MenuCategory.Replace(" ", "_").ToLower();
                        <li class="nav-item mr-2 mb-2">
                            <a class="nav-link @(firstTab ? "active" : "")"
                               data-toggle="pill"
                               href="#@tabId"
                               style="border-radius: var(--ah-radius-pill); font-weight: 700; font-size: 13.5px; padding: 8px 20px;">
                                <i class="icofont icofont-restaurant mr-1"></i> @cat.MenuCategory
                            </a>
                        </li>
                        firstTab = false;
                    }
                }
            </ul>

            <!-- Content Area: Left 8 cols (2-column menu items) + Right 4 cols (Tall Promo Card) -->
            <div class="row">
                <div class="col-lg-8 mb-4 mb-lg-0">
                    <div class="tab-content">
                        @{
                            bool firstPane = true;
                            foreach (var cat in Model.Menu)
                            {
                                var tabId = "menu_" + cat.MenuCategory.Replace(" ", "_").ToLower();
                                <div class="tab-pane fade @(firstPane ? "show active" : "")" id="@tabId">
                                    <div class="row">
                                        @foreach (var item in cat.Lists)
                                        {
                                            <div class="col-sm-6 mb-3">
                                                <div class="ah-menu-mini-card">
                                                    <a asp-controller="Home" asp-action="ProductDetail" asp-route-itemid="@item.StockItemId">
                                                        <img src="@Url.Content(item.ItemPhotoPath)"
                                                             alt="@item.StockItemTitle"
                                                             class="ah-mini-thumb"
                                                             onerror="this.src='/Template/assets/images/about/3.jpg'" />
                                                    </a>

                                                    <div class="ah-mini-info">
                                                        <a asp-controller="Home" asp-action="ProductDetail" asp-route-itemid="@item.StockItemId" class="text-dark">
                                                            <h6 class="ah-mini-title">@item.StockItemTitle</h6>
                                                        </a>
                                                        <div class="ah-mini-meta">
                                                            <span>@(!string.IsNullOrEmpty(item.ItemSize) ? item.ItemSize : item.OrderType)</span>
                                                            <span>&bull;</span>
                                                            <span>15-20 min</span>
                                                        </div>
                                                    </div>

                                                    <div class="d-flex align-items-center">
                                                        <span class="ah-mini-price">₹ @item.UnitPrice</span>
                                                        <button type="button" class="ah-btn-circle-add" onclick="addItem(@item.StockItemId)" title="Add to cart">
                                                            +
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                firstPane = false;
                            }
                        }
                    </div>
                </div>

                <!-- Right Tall Promo Box (Matching Reference Design) -->
                <div class="col-lg-4">
                    <div class="ah-promo-box">
                        <div>
                            <h4>Life is Sweeter with Good Food</h4>
                            <p>Order your favourite sweets and snacks now!</p>
                            <div class="ah-promo-brand">AsliHalwai</div>
                        </div>

                        <img src="~/uploads/stock/08bcc829-e446-462d-9746-0ee3a506b5e7.png"
                             alt="Luxury Sweets Box"
                             class="ah-promo-img"
                             onerror="this.src='/Template/assets/images/about/1.png'" />

                        <div class="mt-3">
                            <a asp-controller="Home" asp-action="AllItems" class="btn ah-btn-pill-primary" style="padding: 9px 24px;">
                                Explore Delights &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </section>

    <!-- ================= 6. BOOK YOUR TABLE BANNER & FORM ================= -->
