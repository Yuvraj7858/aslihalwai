@model AsliHalwaiWebApp.ViewModel.HomeVM
@{
    ViewData["Title"] = "Home";
}

<style>
    /* ================= GLOBAL IMAGE FIX ================= */
    .menu .box,
    .dishes .box {
        display: flex;
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 25px;
        box-shadow: 0 5px 15px rgba(0,0,0,.08);
    }

    .menu .image,
    .dishes .image {
        flex: 0 0 130px;
    }

        .menu .image img,
        .dishes img {
            width: 130px;
            height: 130px;
            object-fit: cover;
            background: #f8f8f8;
        }

    /* ================= MENU TAB FIX ================= */
    .menu .nav-tabs {
        border: none;
        justify-content: center;
        margin-bottom: 30px;
    }

        .menu .nav-tabs .nav-link {
            color: #333 !important;
            font-weight: 600;
            background: #fff;
            border-radius: 30px;
            padding: 10px 22px;
            margin: 5px;
            border: 1px solid #eee;
            transition: .3s;
        }

            .menu .nav-tabs .nav-link:hover,
            .menu .nav-tabs .nav-link.active {
                background: #e54c2a;
                color: #e54c2a !important;
                border-color: #e54c2a;
            }

    /* ================= CAPTION FIX ================= */
    .menu .caption,
    .dishes .caption {
        padding: 15px;
        flex: 1;
    }

        .menu .caption h4,
        .dishes .caption h4 {
            font-size: 16px;
            font-weight: 600;
            color: #e54c2a;
        }

        .menu .caption p,
        .dishes .caption span {
            color: #444;
            font-size: 14px;
        }

    .menu .price {
        font-weight: 700;
        color: #e54c2a;
    }

    /* ================= ORDER SECTION ================= */
    .order {
        text-align: center;
        padding: 70px 0;
    }

    /* ================= BOOK TABLE ================= */
    .reservation {
        background: #111;
        color: #fff;
        padding: 70px 0;
    }

        .reservation h4 {
            color: #e54c2a;
        }

        .reservation input {
            background: transparent;
            border: 1px solid #555;
            color: #fff;
        }

    /* ================= POPULAR DISHES FIX ================= */

    .dishes .owl-carousel .item {
        padding: 10px;
    }

    /* CARD */
    .dish-card {
        background: #fff;
        border-radius: 10px;
        overflow: hidden;
        width: 100%;
        max-width: 260px; /* 🔥 equal card width */
        margin: auto;
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        text-align: center;
    }

    /* IMAGE WRAPPER */
    .dish-img {
        width: 100%;
        height: 180px; /* 🔥 FIXED HEIGHT */
        overflow: hidden;
    }

        .dish-img img {
            width: 100%;
            height: 100%;
            object-fit: cover; /* 🔥 NO STRETCH */
        }

    /* CONTENT */
    .dish-content {
        padding: 12px;
    }

        .dish-content h5 {
            font-size: 16px;
            font-weight: 600;
            color: #e54c2a;
            margin-bottom: 5px;
        }

        .dish-content span {
            font-size: 13px;
            color: #777;
        }

        .dish-content p {
            font-size: 16px;
            font-weight: 700;
            color: #e54c2a;
            margin-top: 6px;
        }

</style>





<!-- ================= SLIDER ================= -->
<div class="slide">
    <div class="slideshow owl-carousel">
        <img src="/Template/assets/images/background/banner-1.jpg" />
        <img src="/Template/assets/images/background/banner-2.jpg" />
        <img src="/Template/assets/images/background/banner-3.jpg" />
        <img src="/Template/assets/images/background/banner-4.jpg" />
    </div>

    <div class="slide-detail text-center">
        <img src="/Template/assets/images/logo/logo-icon.png" />
        <h4>LOVES HEALTHY FOOD</h4>
        <p>Fresh sweets & snacks directly from Asli Halwai</p>
        <a href="#menu" class="btn btn-theme btn-wide">Today's Menu</a>
    </div>
</div>

<!-- ================= ORDER DELIVERY ================= -->
<div class="order">
    <div class="container">
        <h4>Order Delivery And Take Out</h4>
        <p>Choose food, place order & get it delivered</p>

        <form class="mt-4">
            <input class="form-control d-inline w-50" placeholder="Search keyword" />
            <button class="btn btn-theme ms-2">SEARCH</button>
        </form>

        <ul class="list-inline mt-4">
            <li class="list-inline-item"><p>Select Food</p></li>
            <li class="list-inline-item"><p>Order Food</p></li>
            <li class="list-inline-item"><p>Delivery / Take Out</p></li>
        </ul>
    </div>
</div>

<!-- ================= POPULAR DISHES ================= -->
@if (Model.PopularDishes.Any())
{
    <div class="dishes">
        <div class="container">
            <h4 class="text-center mb-4">Our Popular Dishes</h4>

            <div class="dish owl-carousel">
                @foreach (var item in Model.PopularDishes)
                {
                    <div class="item">
                       <a asp-controller="Home"
                         accesskey=""  asp-action="ProductDetail"
                                  asp-route-itemid="@item.StockItemId"
                                      class="dish-link">

                                  <div class="dish-card">

                            <div class="dish-img">
                                <img src="@item.ItemPhotoPath"
                                     alt="@item.StockItemTitle" />
                            </div>

                            <div class="dish-content">
                                <h5>@item.StockItemTitle</h5>
                                <span>@item.OrderType</span>
                                <p>₹ @item.UnitPrice</p>
                            </div>
                        </div>
                        </a>
                    </div>
                }
            </div>

        </div>
    </div>
}

<!-- ================= MENU ================= -->
<div class="menu" id="menu">
    <div class="container">
        <h4 class="text-center">Our Menu</h4>

        <ul class="nav nav-tabs">
            @{
                bool first = true;
                foreach (var cat in Model.Menu)
                {
                    var id = cat.MenuCategory.Replace(" ", "_").ToLower();
                    <li class="nav-item">
                        <a class="nav-link @(first ? "active" : "")"
                           data-toggle="tab"
                           href="#@id">
                            @cat.MenuCategory
                        </a>

                    </li>
                    ;
                    first = false;
                }
            }
        </ul>

        <div class="tab-content">
            @{
                bool pane = true;
                foreach (var cat in Model.Menu)
                {
                    var id = cat.MenuCategory.Replace(" ", "_").ToLower();
                    <div class="tab-pane fade @(pane ? "show active" : "")" id="@id">
                        <div class="row">
                            @foreach (var item in cat.Lists)
                            {
                                <div class="col-md-6">
                                    <a asp-controller="Home"
   asp-action="ProductDetail"
   asp-route-itemid="@item.StockItemId"
   class="menu-link">

    <div class="box">

                                        <div class="image">
                                            <img src="@item.ItemPhotoPath" />
                                        </div>
                                        <div class="caption">
                                            <h4>@item.StockItemTitle - @item.ItemSize</h4>
                                            <p>@item.OrderType</p>
                                            <div class="price">₹ @item.UnitPrice</div>
                                        </div>
                                    </div>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                    pane = false;
                }
            }
        </div>

        <div class="text-center mt-4">
            <a class="btn btn-theme-alt btn-wide">View More</a>
        </div>
    </div>
</div>

<!-- ================= BOOK YOUR TABLE ================= -->
        @await Html.PartialAsync(
        "_Partial_TableReservation",
                new AsliHalwaiWebApp.Models.TableReservationVM()
                )

@if (TempData["ReservationSuccess"] != null)
{
    <div class="alert alert-success text-center">
        @TempData["ReservationSuccess"]
    </div>
}
