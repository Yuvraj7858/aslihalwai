@model AsliHalwaiWebApp.Models.TableReservationVM


<!-- Reservation Start -->
<div class="reservation" id="reservationtable">
    <div class="container">
        <div class="row">
            <!-- Title -->
            <div class="col-sm-12 commontop white text-center">
                <h4>Book Your Table</h4>
                <div class="divider style-1 center">
                    <span class="hr-simple left"></span>
                    <i class="icofont icofont-ui-press hr-icon"></i>
                    <span class="hr-simple right"></span>
                </div>
                <p>
                    Decide on a date and time: Choose the date and time you want
                    to visit the restaurant.
                </p>
            </div>

            <div class="col-md-12 col-12">
                <!-- Reservation Form -->
                <form asp-action="BookTable"
                      asp-controller="TableReservation"
                      method="post"
                      class="row reservation-form"
                      novalidate>

                    @Html.AntiForgeryToken()

                    <!-- Hidden ID (future use) -->
                    <input type="hidden" asp-for="TableReservationId" />

                    <!-- Full Name -->
                    <div class="form-group col-md-4 col-sm-6">
                        <i class="icofont icofont-ui-user"></i>
                        <input asp-for="FullName" class="form-control" placeholder="name" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <!-- Email -->
                    <div class="form-group col-md-4 col-sm-6">
                        <i class="icofont icofont-ui-message"></i>
                        <input asp-for="EmailAddress" class="form-control" placeholder="email" />
                        <span asp-validation-for="EmailAddress" class="text-danger"></span>
                    </div>

                    <!-- Mobile -->
                    <div class="form-group col-md-4 col-sm-6">
                        <i class="icofont icofont-phone"></i>
                        <input asp-for="MobileNo" class="form-control" placeholder="mobile number" />
                        <span asp-validation-for="MobileNo" class="text-danger"></span>
                    </div>

                    <!-- Reservation Date -->
                    <div class="form-group col-md-4 col-sm-6">
                        <i class="icofont icofont-ui-calendar"></i>
                        <input asp-for="ReservationDate" type="date" class="form-control" />
                        <span asp-validation-for="ReservationDate" class="text-danger"></span>
                    </div>

                    <!-- Reservation Time -->
                    <div class="form-group col-md-4 col-sm-6">
                        <i class="icofont icofont-clock-time"></i>
                        <input asp-for="ReservationTime" class="form-control" placeholder="hh:mm AM/PM" />
                        <span asp-validation-for="ReservationTime" class="text-danger"></span>
                    </div>

                    <!-- No Of Person -->
                    <div class="form-group col-md-4 col-sm-6">
                        <i class="icofont icofont-users"></i>
                        <input asp-for="NoOfPerson" class="form-control" placeholder="number of persons" />
                        <span asp-validation-for="NoOfPerson" class="text-danger"></span>
                    </div>

                    <!-- Submit -->
                    <button type="submit"
                            class="btn btn-theme btn-wide"
                            onclick="this.form.submit(); return true;">
                        BOOK NOW
                    </button>


                </form>
                <!-- Reservation Form End -->
            </div>
        </div>
    </div>
</div>
<!-- Reservation End -->
