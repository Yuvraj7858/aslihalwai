    <script>
       function refreshCartCount() {
        fetch('/Order/GetCartCount')
            .then(res => res.json())
            .then(count => {
                // Desktop floating cart
                const desktopBadge = document.querySelector('.floating-cart-count');
                if (desktopBadge) {
                    if (count > 0) {
                        desktopBadge.innerText = count;
                        desktopBadge.style.display = 'inline-block';
                        document.querySelector('.floating-cart').style.display = 'block';
                    } else {
                        desktopBadge.style.display = 'none';
                        document.querySelector('.floating-cart').style.display = 'none';
                    }
                }

                  // Mobile bottom navbar cart
                 const mobileBadge = document.getElementById('mobileCartCount');
                 if (mobileBadge) {
                     if (count > 0) {
                         mobileBadge.innerText = count;
                         mobileBadge.style.display = 'block';
                     } else {
                         mobileBadge.style.display = 'none';
                     }
                 }
             });



                  // Page load pe refresh
        document.addEventListener("DOMContentLoaded", function() {
            refreshCartCount();

             // Bottom navbar cart click
         const mobileCartLink = document.querySelector('.fixed-bottom-navbar .col:nth-child(3) a');
         if (mobileCartLink) {
             mobileCartLink.addEventListener('click', function(e) {
                 if (parseInt(document.getElementById('mobileCartCount').innerText) === 0) {
                     e.preventDefault();
                     alert('Your cart is empty!');
                 }
             });
      


 

