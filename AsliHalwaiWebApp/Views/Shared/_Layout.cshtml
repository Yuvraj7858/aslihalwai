                                    <ul class="nav navbar-nav">
                                      

                                    </ul>

                                   
                                </div>

                                <div class="navbar-header">
                                    <span class="menutext d-block d-md-none">Menu</span>
                                    <button data-target=".navbar-ex1-collapse" data-toggle="collapse" class="btn btn-navbar navbar-toggler" type="button"><i class="icofont icofont-navigation-menu"></i></button>
                                </div>
                                <div class="collapse navbar-collapse navbar-ex1-collapse padd0">
                                    <ul class="nav navbar-nav">
                                        <li class="nav-item"><a asp-controller="Home" asp-action="Index">HOME</a></li>
                                        <li class="nav-item"><a asp-controller="Home" asp-action="AboutUs">about us</a></li>
                                        @if (Context.Session.GetInt32("UserTypeId") == 1)
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link"
                                                   asp-controller="AdminOrder"
                                                   asp-action="InvoiceDashboard">
                                                    🧾 Invoices
                                                </a>
                                            </li>
                                        }

                                        @* ===== USER ADDRESS (ALL USERS) ===== *@
                                        <li class="nav-item"><a asp-controller="Setting" asp-action="List_UserAddress">Address</a></li>

                                        @* ===== SETTINGS (ADMIN / STAFF ONLY) ===== *@

                                        @if (userTypeId == 1)
                                        {
                                            <li class="nav-item dropdown">
                                                <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                                    Settings
                                                </a>
                                                   

                                                <div class="dropdown-menu">

                                                    <a class="dropdown-item"
                                                       asp-controller="AdminOrder"
                                                       asp-action="Index">
                                                        Manage Order
                                                    </a>

                                                    <a class="dropdown-item"
                                                       asp-controller="Setting"
                                                       asp-action="List_UserTypes">
                                                        User Types
                                                    </a>

                                                    <a class="dropdown-item"
                                                       asp-controller="Setting"
                                                       asp-action="List_Genders">
                                                        Genders
                                                    </a>

                                                    <a class="dropdown-item"
                                                       asp-controller="Setting"
                                                       asp-action="List_UserStatus">
                                                        Account Status
                                                    </a>

                                                    <a class="dropdown-item"
                                                       asp-controller="Stock"
                                                       asp-action="StockItem">
                                                        Add Items
                                                    </a>

                                                    <a class="dropdown-item"
                                                       asp-controller="Setting"
                                                       asp-action="List_VisibleStatus">
                                                        Record Visible Status
                                                    </a>

                                                    <a class="dropdown-item"
                                                       asp-controller="Stock"
                                                       asp-action="StockMenuCategory">
                                                        Stock Menu Category
                                                    </a>

                                                    <a class="dropdown-item"
                                                       asp-controller="Stock"
                                                       asp-action="StockItemCategory">
                                                        Stock Item Category
                                                    </a>
                                                </div>
                                            </li>
                                        }


                                     <!--add here -->
                                        @if (userTypeId == 1)
                                        {
                                            <li class="nav-item">
                                                <a asp-controller="Stock"
                                                   asp-action="OrderType">
                                                    Order Type 
                                                </a>
                                            </li>
           
                                        }

                                        <li class="nav-item"><a asp-controller="Home" asp-action="ContactUs">contact us</a></li>
                                        <li class="nav-item"><a asp-controller="Home" asp-action="AllItems">Shop</a></li>
                                    </ul>
                                </div>
                            </nav>
                        </div>
                        <!-- Main Menu End -->
                    </div>
                    <div class="col-md-2 col-sm-12 col-12 button-top paddleft">
                        <a class="btn-primary btn" asp-controller="TableReservation" asp-action="BookingTables">Reservation</a>
                    </div>
                </div>
            </div>
        </header>
        <!-- Header End   -->
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
        <!-- Footer Start -->
