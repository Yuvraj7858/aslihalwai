                                       aria-expanded="false">
                                        <i class="icofont icofont-ui-user"></i> My Account
                                    </a>


                                    <ul class="dropdown-menu dropdown-menu-right drophover">

                                        @if (!isLoggedIn)
                                        {
                                            <li class="dropdown-item">
                                                <a asp-controller="User" asp-action="Login">Login</a>
                                            </li>
                                            <li class="dropdown-item">
                                                <a asp-controller="User" asp-action="Register">Register</a>
                                            </li>
                                        }
                                        else
                                        {
                                            <li class="dropdown-item">
                                                <a asp-controller="User" asp-action="Dashboard">Dashboard</a>
                                            </li>
                                            <li class="dropdown-item">
                                                <a asp-controller="User" asp-action="Logout">Logout</a>
                                            </li>
                                        }

                                    </ul>
                                </li>


                                <li class="list-inline-item">
                                    <ul class="list-inline social">
                                        <li class="list-inline-item"><a href="https://www.youtube.com/" target="_blank"><i class="icofont icofont-social-facebook"></i></a></li>
                                        <li class="list-inline-item"><a href="#" target="_blank"><i class="icofont icofont-social-twitter"></i></a></li>
                                        <li class="list-inline-item"><a href="#" target="_blank"><i class="icofont icofont-social-google-plus"></i></a></li>
                                        <li class="list-inline-item"><a href="#" target="_blank"><i class="icofont icofont-social-instagram"></i></a></li>
