                        <ul class="list-unstyled contact">
                            <li><i class="icofont icofont-social-google-map"></i> Office 08, first floor, Pizza Restaurant & Drinks, Bank More, Dhanbad,Jharkhand, IN</li>
                            <li><i class="icofont icofont-phone"></i> 8987820546,<br>+91 7858908966</li>
                            <li><a href="#"><i class="icofont icofont-ui-message"></i>info@aslihalwai.com</a></li>
                        </ul>
