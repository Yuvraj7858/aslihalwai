@{
    int userId = Context.Session.GetInt32("UserId") ?? 0;
    int userTypeId = Context.Session.GetInt32("UserTypeId") ?? 0;
    bool isLoggedIn = userId > 0;
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool isHomePage = currentController == "Home" && currentAction == "Index";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="theme-color" content="#ff4d00">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">

    <!-- Favicon -->
    <link type="image/x-icon" rel="shortcut icon" href="~/favicon.png" />
    <title>AsliHalwai - Real Taste, Right at Your Doorstep</title>
    <meta name="description" content="Fresh Sweets, Snacks & More — From AsliHalwai to Your Home. Authentic recipes in pure desi ghee.">

    <!-- Google Fonts: Plus Jakarta Sans, Inter, Caveat -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Caveat:wght@600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 4 -->
    <link href="~/Template/assets/lib/bootstrap-4.5.0/css/bootstrap.css" rel="stylesheet">
    <!-- icofont -->
    <link href="~/Template/assets/lib/icofont/css/icofont.css" rel="stylesheet" type="text/css" />
    <!-- OwlCarousel -->
    <link href="~/Template/assets/lib/owlcarousel2/assets/owl.carousel.css" rel="stylesheet" type="text/css" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    <!-- Base stylesheet -->
    <link href="~/Template/assets/css/style.css" rel="stylesheet" type="text/css" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />

    <!-- Exact Reference Design System -->
    <link href="~/css/aslihalwai-premium.css" rel="stylesheet" asp-append-version="true" />
</head>

<body>
    <!-- Toast notifications container inside body -->
    <div id="toastContainer" style="position: fixed; top: 75px; right: 20px; z-index: 99999;"></div>

    <div class="wrapper">
        <!-- ================= 1. TOP UTILITY BAR (Terracotta Red/Orange) ================= -->
        <div class="ah-top-bar d-none d-md-block">
            <div class="container d-flex justify-content-between align-items-center">
                <!-- Left: Phone & Location -->
                <div class="d-flex align-items-center">
                    <a href="tel:+917557785890" class="mr-3">
                        <i class="icofont icofont-phone"></i> +91 7557785890
                    </a>
                    <span class="mr-3 text-white-50">|</span>
                    <span style="font-size: 12px;">
                        <i class="icofont icofont-location-pin"></i> Dhanbad, Jharkhand
                    </span>
                </div>

                <!-- Center: Trust statement -->
                <div class="ah-top-bar-center d-none d-lg-block">
                    Freshly Made &bull; Hygienic &bull; Trusted Since 2002
                </div>

                <!-- Right: Social Links -->
                <div class="d-flex align-items-center">
                    <ul class="ah-top-socials">
                        <li><a href="https://www.facebook.com/" target="_blank" title="Facebook"><i class="icofont icofont-social-facebook"></i></a></li>
                        <li><a href="https://www.instagram.com/" target="_blank" title="Instagram"><i class="icofont icofont-social-instagram"></i></a></li>
                        <li><a href="https://www.youtube.com/" target="_blank" title="YouTube"><i class="icofont icofont-social-youtube-play"></i></a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- ================= 2. DESKTOP MAIN NAVBAR ================= -->
        <header class="ah-main-header d-none d-lg-block">
            <div class="container">
                <!-- Brand Logo -->
                <a class="ah-brand-logo" asp-controller="Home" asp-action="Index">
                    <img src="~/Template/assets/images/logo/logo.png" alt="AsliHalwai Sweets & Snacks" />
                </a>

                <!-- Centered Nav Links -->
                <ul class="ah-nav-menu">
                    <li><a class="ah-nav-link @(isHomePage ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a class="ah-nav-link @(currentAction == "AboutUs" ? "active" : "")" asp-controller="Home" asp-action="AboutUs">About Us</a></li>
                    <li><a class="ah-nav-link" href="#menu">Menu</a></li>
                    <li><a class="ah-nav-link @(currentAction == "AllItems" ? "active" : "")" asp-controller="Home" asp-action="AllItems">Our Shops</a></li>
                    <li><a class="ah-nav-link @(currentAction == "ContactUs" ? "active" : "")" asp-controller="Home" asp-action="ContactUs">Contact</a></li>

                    @if (userTypeId == 1)
                    {
                        <li class="dropdown">
                            <a class="ah-nav-link dropdown-toggle text-danger font-weight-bold" href="#" data-toggle="dropdown">
                                Admin
                            </a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item" asp-controller="AdminOrder" asp-action="InvoiceDashboard">🧾 Invoices</a>
                                <a class="dropdown-item" asp-controller="AdminOrder" asp-action="Index">Manage Orders</a>
                                <a class="dropdown-item" asp-controller="Stock" asp-action="StockItem">Add Food Items</a>
                                <a class="dropdown-item" asp-controller="Stock" asp-action="OrderType">Order Types</a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" asp-controller="Setting" asp-action="List_UserAddress">Manage Addresses</a>
                                <a class="dropdown-item" asp-controller="TableReservation" asp-action="BookingTables">Table Bookings</a>
                            </div>
                        </li>
                    }
                </ul>

                <!-- Right Actions: Search Icon, Cart Icon, Login/Sign Up Button -->
                <div class="ah-header-actions">
                    <!-- Search Icon Trigger -->
                    <a asp-controller="Home" asp-action="AllItems" class="ah-icon-btn" title="Search Dishes">
                        <i class="icofont icofont-search"></i>
                    </a>

                    <!-- Cart Icon with Badge -->
                    <a href="@Url.Action("ViewCart", "Order")" class="ah-icon-btn" title="View Cart">
                        <i class="fa fa-shopping-cart"></i>
                        <span class="ah-badge-count floating-cart-count" style="display:none">0</span>
                    </a>

                    <!-- Login / Sign Up Pill Button -->
                    @if (!isLoggedIn)
                    {
                        <a asp-controller="User" asp-action="Login" class="ah-btn-pill-primary">
                            Login / Sign Up
                        </a>
                    }
                    else
                    {
                        <div class="dropdown d-inline-block">
                            <a class="ah-btn-pill-primary dropdown-toggle" href="#" id="authDropdown" data-toggle="dropdown">
                                <i class="icofont icofont-user-alt-7"></i> Account
                            </a>
                            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="authDropdown">
                                <a class="dropdown-item" asp-controller="User" asp-action="Dashboard"><i class="icofont icofont-dashboard mr-2 text-primary"></i> Dashboard</a>
                                <a class="dropdown-item" asp-controller="Setting" asp-action="List_UserAddress"><i class="icofont icofont-location-pin mr-2 text-warning"></i> My Addresses</a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item text-danger" asp-controller="User" asp-action="Logout"><i class="icofont icofont-logout mr-2"></i> Logout</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </header>

        <!-- ================= 3. MOBILE HEADER (App Bar Style) ================= -->
        <div class="ah-mobile-header d-lg-none" style="background:#fff; padding:10px 16px; box-shadow:0 2px 8px rgba(0,0,0,0.06); position:sticky; top:0; z-index:1020;">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    @if (!isHomePage)
                    {
                        <button type="button" class="ah-icon-btn mr-2" onclick="window.history.back()" title="Go Back" style="width:34px;height:34px;font-size:14px;">
                            <i class="icofont icofont-arrow-left"></i>
                        </button>
                    }
                    <a class="ah-brand-logo" asp-controller="Home" asp-action="Index">
                        <img src="~/Template/assets/images/logo/logo.png" alt="AsliHalwai" style="height: 38px;" />
                    </a>
                </div>

                <div class="d-flex align-items-center">
                    <a asp-controller="Home" asp-action="AllItems" class="ah-icon-btn mr-2" style="width:36px;height:36px;font-size:14px;" title="Search">
                        <i class="icofont icofont-search"></i>
                    </a>
                    <a href="@Url.Action("ViewCart", "Order")" class="ah-icon-btn mr-2" style="width:36px;height:36px;font-size:14px;" title="Cart">
                        <i class="fa fa-shopping-cart"></i>
                        <span class="ah-badge-count floating-cart-count" style="display:none">0</span>
                    </a>
                    <button type="button" class="ah-icon-btn" data-toggle="modal" data-target="#mobileMenuModal" style="width:36px;height:36px;font-size:16px;" title="Menu">
                        <i class="icofont icofont-navigation-menu"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- ================= MAIN BODY CONTENT ================= -->
        <main role="main">
            @RenderBody()
        </main>

        <!-- ================= 4. EXACT 5-COLUMN FOOTER (Dark Charcoal) ================= -->
        <footer class="ah-footer-exact">
            <div class="container">
                <div class="row">
                    <!-- Column 1: Brand Logo & Description -->
                    <div class="col-lg-3 col-md-6 mb-4">
                        <img src="~/Template/assets/images/logo/logo.png" alt="AsliHalwai Sweets & Snacks" style="height: 48px; margin-bottom: 16px; filter: brightness(0) invert(1);" />
                        <p style="color: #94a3b8; font-size: 13.5px; line-height: 1.7; max-width: 280px;">
                            Bringing happiness to your life with delicious sweets &amp; snacks since 2002.
                        </p>
                        <div class="d-flex align-items-center mt-3">
                            <a href="https://www.facebook.com/" target="_blank" class="ah-icon-btn mr-2" style="background: rgba(255,255,255,0.08); color: #fff !important; width: 34px; height: 34px; font-size: 13px;"><i class="icofont icofont-social-facebook"></i></a>
                            <a href="https://www.instagram.com/" target="_blank" class="ah-icon-btn mr-2" style="background: rgba(255,255,255,0.08); color: #fff !important; width: 34px; height: 34px; font-size: 13px;"><i class="icofont icofont-social-instagram"></i></a>
                            <a href="https://www.google.com/" target="_blank" class="ah-icon-btn mr-2" style="background: rgba(255,255,255,0.08); color: #fff !important; width: 34px; height: 34px; font-size: 13px;"><i class="icofont icofont-social-google-plus"></i></a>
                            <a href="https://www.youtube.com/" target="_blank" class="ah-icon-btn" style="background: rgba(255,255,255,0.08); color: #fff !important; width: 34px; height: 34px; font-size: 13px;"><i class="icofont icofont-social-youtube-play"></i></a>
                        </div>
                    </div>

                    <!-- Column 2: Quick Links -->
                    <div class="col-lg-2 col-md-6 mb-4">
                        <h5>Quick Links</h5>
                        <ul>
                            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                            <li><a asp-controller="Home" asp-action="AboutUs">About Us</a></li>
                            <li><a href="#menu">Menu</a></li>
                            <li><a asp-controller="Home" asp-action="AllItems">Our Shops</a></li>
                            <li><a asp-controller="Home" asp-action="ContactUs">Contact Us</a></li>
                        </ul>
                    </div>

                    <!-- Column 3: Customer Support -->
                    <div class="col-lg-2 col-md-6 mb-4">
                        <h5>Customer Support</h5>
                        <ul>
                            <li><a asp-controller="Home" asp-action="ContactUs">Help Center</a></li>
                            <li><a asp-controller="Home" asp-action="AboutUs">Delivery Information</a></li>
                            <li><a asp-controller="Home" asp-action="AboutUs">Returns &amp; Refunds</a></li>
                            <li><a asp-controller="Home" asp-action="Privacy">Terms &amp; Conditions</a></li>
                            <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        </ul>
                    </div>

                    <!-- Column 4: Contact Us -->
                    <div class="col-lg-3 col-md-6 mb-4">
                        <h5>Contact Us</h5>
                        <ul style="line-height: 1.8;">
                            <li><i class="icofont icofont-location-pin text-warning mr-1"></i> Office 08, First Floor, Pizza Restaurant &amp; Drinks, Bank More, Dhanbad, Jharkhand, IN</li>
                            <li><i class="icofont icofont-phone text-warning mr-1"></i> 886782054x, <a href="tel:+917858908966" class="text-white">+91 7858908966</a></li>
                            <li><i class="icofont icofont-ui-message text-warning mr-1"></i> info@aslihalwai.com</li>
                        </ul>
                    </div>

                    <!-- Column 5: Opening Hours -->
                    <div class="col-lg-2 col-md-6 mb-4">
                        <h5>Opening Hours</h5>
                        <ul style="line-height: 1.8;">
                            <li><strong class="text-white">Mon - Fri:</strong> 9 am to 12 am</li>
                            <li><strong class="text-white">Saturday:</strong> 9 am to 12 am</li>
                            <li><strong class="text-white">Breakfast:</strong> 7 am to 12 pm</li>
                            <li><strong class="text-white">Lunch:</strong> 12 pm to 7 pm</li>
                            <li><strong class="text-white">Dinner:</strong> 7 am to 12 am</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Bottom Bar with Back to Top Button -->
            <div class="ah-footer-bar">
                <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
                    <p class="mb-2 mb-md-0" style="color: #94a3b8;">
                        Copyright &copy; AsliHalwai - Sweets &amp; Snacks 2026. All Rights Reserved.
                    </p>
                    <div class="d-flex align-items-center gap-3">
                        <span class="mr-3 text-muted">Made with <span style="color: #ef4444;">&hearts;</span> for Food Lovers</span>
                        <a href="#" class="ah-back-to-top" title="Back to top">
                            <i class="icofont icofont-arrow-up"></i>
                        </a>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- ================= 5. NATIVE MOBILE BOTTOM BAR (Home, Shop, Search, Cart, Account) ================= -->
    <nav class="ah-mobile-bottom-bar d-lg-none">
        <div class="ah-bottom-bar-grid">
            <!-- 1. Home -->
            <a asp-controller="Home" asp-action="Index" class="ah-bottom-bar-item @(isHomePage ? "active" : "")">
                <i class="icofont icofont-home"></i>
                <span>Home</span>
            </a>
            <!-- 2. Shop -->
            <a asp-controller="Home" asp-action="AllItems" class="ah-bottom-bar-item @(currentController == "Home" && currentAction == "AllItems" ? "active" : "")">
                <i class="icofont icofont-restaurant"></i>
                <span>Shop</span>
            </a>
            <!-- 3. Search -->
            <a asp-controller="Home" asp-action="AllItems" class="ah-bottom-bar-item">
                <i class="icofont icofont-search"></i>
                <span>Search</span>
            </a>
            <!-- 4. Cart -->
            <a href="@Url.Action("ViewCart", "Order")" class="ah-bottom-bar-item @(currentController == "Order" ? "active" : "")" id="mobileCartBtnLink">
                <i class="icofont icofont-cart-alt"></i>
                <span class="ah-bottom-cart-badge" id="mobileCartCount" style="display:none;">0</span>
                <span>Cart</span>
            </a>
            <!-- 5. Account -->
            @if (isLoggedIn)
            {
                <a asp-controller="User" asp-action="Dashboard" class="ah-bottom-bar-item @(currentController == "User" ? "active" : "")">
                    <i class="icofont icofont-ui-user"></i>
                    <span>Account</span>
                </a>
            }
            else
            {
                <a asp-controller="User" asp-action="Login" class="ah-bottom-bar-item @(currentController == "User" ? "active" : "")">
                    <i class="icofont icofont-login"></i>
                    <span>Login</span>
                </a>
            }
        </div>
    </nav>

    <!-- ================= 6. MOBILE DRAWER MODAL ================= -->
    <div class="modal fade ah-drawer-modal" id="mobileMenuModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content ah-drawer-content">
                <div class="ah-drawer-handle"></div>
                <div class="ah-drawer-header">
                    <h5>AsliHalwai Menu</h5>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="p-0">
                    <a asp-controller="Home" asp-action="Index" class="ah-drawer-item">
                        <span><i class="icofont icofont-home"></i> Home</span>
                        <i class="icofont icofont-curved-right text-muted"></i>
                    </a>
                    <a asp-controller="Home" asp-action="AllItems" class="ah-drawer-item">
                        <span><i class="icofont icofont-restaurant"></i> Sweets &amp; Savouries Shop</span>
                        <i class="icofont icofont-curved-right text-muted"></i>
                    </a>
                    <a href="#reservation" class="ah-drawer-item" data-dismiss="modal">
                        <span><i class="icofont icofont-table"></i> Book Your Table</span>
                        <i class="icofont icofont-curved-right text-muted"></i>
                    </a>
                    <a asp-controller="Setting" asp-action="List_UserAddress" class="ah-drawer-item">
                        <span><i class="icofont icofont-location-pin"></i> Saved Addresses</span>
                        <i class="icofont icofont-curved-right text-muted"></i>
                    </a>
                    <a asp-controller="Home" asp-action="AboutUs" class="ah-drawer-item">
                        <span><i class="icofont icofont-info-circle"></i> About Us</span>
                        <i class="icofont icofont-curved-right text-muted"></i>
                    </a>
                    <a asp-controller="Home" asp-action="ContactUs" class="ah-drawer-item">
                        <span><i class="icofont icofont-contacts"></i> Contact Us</span>
                        <i class="icofont icofont-curved-right text-muted"></i>
                    </a>
                    <a asp-controller="Home" asp-action="Privacy" class="ah-drawer-item">
                        <span><i class="icofont icofont-shield"></i> Privacy Policy &amp; Terms</span>
                        <i class="icofont icofont-curved-right text-muted"></i>
                    </a>

                    @if (userTypeId == 1)
                    {
                        <div class="px-3 pt-3 pb-1 text-uppercase text-muted" style="font-size: 11px; font-weight: 800;">
                            Admin Controls
                        </div>
                        <a asp-controller="AdminOrder" asp-action="InvoiceDashboard" class="ah-drawer-item">
                            <span><i class="icofont icofont-file-alt"></i> Invoices</span>
                            <i class="icofont icofont-curved-right text-muted"></i>
                        </a>
                        <a asp-controller="AdminOrder" asp-action="Index" class="ah-drawer-item">
                            <span><i class="icofont icofont-tasks"></i> Manage Orders</span>
                            <i class="icofont icofont-curved-right text-muted"></i>
                        </a>
                        <a asp-controller="Stock" asp-action="StockItem" class="ah-drawer-item">
                            <span><i class="icofont icofont-ui-add"></i> Add Items</span>
                            <i class="icofont icofont-curved-right text-muted"></i>
                        </a>
                    }

                    @if (isLoggedIn)
                    {
                        <div class="p-3">
                            <a asp-controller="User" asp-action="Logout" class="btn btn-outline-danger btn-block" style="border-radius: var(--ah-radius-pill); font-weight: 700;">
                                <i class="icofont icofont-logout"></i> Logout
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 d-flex">
                            <a asp-controller="User" asp-action="Login" class="btn ah-btn-pill-primary flex-fill mr-2 text-center">
                                Login
                            </a>
                            <a asp-controller="User" asp-action="Register" class="btn btn-outline-secondary flex-fill text-center" style="border-radius: var(--ah-radius-pill); font-weight: 700;">
                                Register
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/Template/assets/lib/jquery/jquery.min.js"></script>
    <script src="~/Template/assets/lib/jquery-validation/jquery.validate.min.js"></script>
    <script src="~/Template/assets/lib/popper/popper.min.js"></script>
    <script src="~/Template/assets/lib/bootstrap-4.5.0/js/bootstrap.js"></script>
    <script src="~/Template/assets/lib/owlcarousel2/owl.carousel.min.js"></script>
    <script src="~/Template/assets/lib/jquery.inview/jquery.inview.min.js"></script>
    <script src="~/Template/assets/lib/jquery.countTo/jquery.countTo.js"></script>
    <script src="~/Template/assets/lib/mb.YTPlayer/jquery.mb.YTPlayer.min.js"></script>
    <script src="~/Template/assets/js/internal.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function refreshCartCount() {
            fetch('/Order/GetCartCount')
                .then(res => res.json())
                .then(count => {
                    const desktopBadges = document.querySelectorAll('.floating-cart-count');
                    desktopBadges.forEach(badge => {
                        if (count > 0) {
                            badge.innerText = count;
                            badge.style.display = 'inline-flex';
                        } else {
                            badge.style.display = 'none';
                        }
                    });

                    const mobileBadge = document.getElementById('mobileCartCount');
                    if (mobileBadge) {
                        if (count > 0) {
                            mobileBadge.innerText = count;
                            mobileBadge.style.display = 'inline-flex';
                        } else {
                            mobileBadge.style.display = 'none';
                        }
                    }
                })
                .catch(err => console.log('Cart count error:', err));
        }

        document.addEventListener("DOMContentLoaded", function () {
            refreshCartCount();

            // Smooth scroll for back to top
            const backToTop = document.querySelector('.ah-back-to-top');
            if (backToTop) {
                backToTop.addEventListener('click', function (e) {
                    e.preventDefault();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }
        });
    </script>
</body>
</html>
