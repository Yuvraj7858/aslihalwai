@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong - AsliHalwai";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="ah-dish-card p-4 p-md-5 text-center">
                <div style="width: 70px; height: 70px; background: #fee2e2; color: #ef4444; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 32px; margin-bottom: 20px;">
                    <i class="icofont icofont-exclamation-tringle"></i>
                </div>

                <h3 class="font-weight-bold mb-2" style="color: #111827;">Something Went Wrong</h3>
                <p class="text-muted mb-4 small">
                    An unexpected issue occurred while loading this page. Our team has been notified.
                </p>

                @if (Model != null && Model.ShowRequestId)
                {
                    <p class="small text-muted mb-4">
                        Request ID: <code class="text-monospace">@Model.RequestId</code>
                    </p>
                }

                <a asp-controller="Home" asp-action="Index" class="btn ah-btn-pill-primary" style="display: inline-flex; width: auto;">
                    <i class="icofont icofont-home mr-1"></i> Return to Homepage
                </a>
            </div>
        </div>
    </div>
</div>
