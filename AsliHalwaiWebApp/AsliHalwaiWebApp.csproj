<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
		<!-- Restores the Google authentication registration that the original
		     Program.cs used. There is currently no Google login UI/endpoint. -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.12" />
		<!-- Patched SQLite native library (transitive version 2.1.11 has GHSA-2m69-gcr7-jv3q). -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Data\" />
		<Folder Include="Helper\NewFolder\" />
		<Folder Include="wwwroot\uploads\ingredients\" />
		<Folder Include="wwwroot\uploads\stock\" />
		<Folder Include="wwwroot\uploads\otherfiles\" />
	</ItemGroup>

</Project>
